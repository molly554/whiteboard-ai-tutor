    {
     "op": "write",
     "id": "light-reaction",
     "x": 880,
     "y": 640,
     "text": "光反应：类囊体薄膜",
     "size": 34,
     "color": "blue"
    },
    {
     "op": "write",
     "id": "dark-reaction",
     "x": 880,
     "y": 700,
     "text": "暗反应：叶绿体基质",
     "size": 34,
     "color": "blue"
