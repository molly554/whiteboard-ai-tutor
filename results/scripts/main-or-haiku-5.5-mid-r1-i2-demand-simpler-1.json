    {
     "op": "line",
     "id": "p1line",
     "x1": 200,
     "y1": 470,
     "x2": 740,
     "y2": 470,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "op": "line",
     "id": "q2line",
     "x1": 740,
     "y1": 470,
     "x2": 740,
     "y2": 720,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "op": "write",
     "id": "q2",
     "x": 740,
     "y": 735,
     "text": "Q2",
     "size": 32,
     "anchor": "middle",
     "color": "red"
    }
   ]
  }
 ]
