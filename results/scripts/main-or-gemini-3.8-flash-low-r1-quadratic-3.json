     "width": 4
    },
    {
     "op": "write",
     "id": "t_ans",
     "x": 970,
     "y": 715,
     "text": "x = 2   or   x = 3",
     "size": 40,
     "color": "green",
     "anchor": "middle"
    }
   ]
  }
 ]
