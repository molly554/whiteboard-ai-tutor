{
 "title": "光合作用发生部位",
 "lang": "zh",
 "steps": [
  {
   "title": "提出问题",
   "say": "先看问题：光合作用发生在细胞的哪个部分？",
   "ops": [
    {
     "op": "write",
     "id": "title",
     "x": 80,
     "y": 60,
     "text": "光合作用发生在哪里？",
     "size": 56,
     "color": "ink"
    }
   ]
  },
  {
   "title": "画出植物细胞",
   "say": "先画一个植物细胞，光合作用就发生在这样的细胞里。",
   "ops": [
    {
     "op": "rect",
     "id": "cell",
     "x": 120,
     "y": 180,
     "w": 620,
     "h": 520,
     "color": "green",
     "width": 5,
     "fill": "green"
    },
    {
     "op": "write",
     "id": "cell-label",
     "x": 150,
     "y": 205,
     "text": "植物细胞",
     "size": 36,
     "color": "gray"
    }
   ]
  },
  {
   "title": "找到叶绿体",
   "say": "细胞里绿色的椭圆结构就是叶绿体，它是光合作用的场所。",
