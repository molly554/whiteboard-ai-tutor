    },
    {
     "op": "write",
     "id": "label_d1",
     "x": 1085,
     "y": 690,
     "text": "D1",
     "size": 32,
     "color": "blue"
    }
   ]
  },
  {
   "title": "Original supply",
   "say": "The supply curve S is upward sloping, and together they create an equilibrium.",
