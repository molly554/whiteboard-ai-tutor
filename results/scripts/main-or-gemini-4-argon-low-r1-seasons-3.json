    },
    {
     "op": "write",
     "id": "june_s_lbl",
     "x": 150,
     "y": 675,
     "text": "South: Winter",
     "size": 30,
     "color": "blue",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "December: Tilted Away",
   "say": "Six months later in December, Earth is on the other side of the Sun. The axis points the exact same way, so the North now tilts away.",
