    {
     "op": "ellipse",
     "id": "earth_left",
     "cx": 260,
     "cy": 500,
     "rx": 55,
     "ry": 55,
     "color": "ink",
     "fill": "blue"
    },
    {
     "op": "line",
     "id": "axis_left",
     "x1": 225,
     "y1": 590,
     "x2": 295,
     "y2": 410,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "line",
     "id": "eq_left",
     "x1": 210,
     "y1": 480,
     "x2": 310,
     "y2": 520,
     "color": "gray",
     "width": 2,
     "dash": true
    },
    {
     "op": "line",
     "id": "ray_june_1",
     "x1": 710,
     "y1": 480,
     "x2": 330,
     "y2": 480,
     "color": "red",
     "width": 3,
     "arrow": true
    },
    {
     "op": "write",
     "id": "lbl_june",
     "x": 260,
     "y": 620,
     "text": "June",
     "size": 34,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "desc_june",
     "x": 260,
