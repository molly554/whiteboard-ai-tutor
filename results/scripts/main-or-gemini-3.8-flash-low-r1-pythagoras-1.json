    },
    {
     "op": "write",
     "id": "lbl2_side",
     "x": 1180,
     "y": 750,
     "text": "Total side = a + b",
     "size": 34,
     "color": "gray",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Uncovered Space is a² + b²",
   "say": "This regrouping leaves two empty squares: one of size a by a, and one of size b by b.",
   "ops": [
    {
     "op": "rect",
     "id": "sq_a2",
     "x": 1260,
     "y": 240,
     "w": 140,
     "h": 140,
     "color": "red",
     "width": 4,
     "fill": "red"
    },
    {
     "op": "write",
     "id": "lbl_a2",
     "x": 1330,
     "y": 295,
     "text": "a²",
     "size": 36,
     "color": "red",
     "anchor": "middle"
    },
    {
     "op": "rect",
     "id": "sq_b2",
     "x": 960,
     "y": 380,
     "w": 300,
     "h": 300,
     "color": "red",
     "width": 4,
     "fill": "red"
    },
    {
     "op": "write",
     "id": "lbl_b2",
     "x": 1110,
     "y": 515,
     "text": "b²",
     "size": 40,
     "color": "red",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Conclusion: a² + b² = c²",
   "say": "Since both outer squares are identical and have 4 triangles removed, the remaining areas must be equal!",
   "ops": [
    {
     "op": "rect",
     "id": "res_box",
     "x": 480,
     "y": 800,
     "w": 640,
     "h": 70,
     "color": "ink",
     "width": 4
    },
    {
     "op": "write",
     "id": "final_eq",
     "x": 800,
     "y": 815,
     "text": "Remaining Area:  c²  =  a² + b²",
     "size": 42,
     "color": "ink",
     "anchor": "middle"
    }
   ]
  }
 ]
