{
 "title": "Why the Pythagorean Theorem Works",
 "lang": "en",
 "steps": [
  {
   "title": "The Right Triangle",
   "say": "Let's start with a right-angled triangle with legs a and b, and hypotenuse c.",
   "ops": [
    {
     "op": "write",
     "id": "title",
     "x": 800,
     "y": 50,
     "text": "Why does a² + b² = c² work?",
     "size": 56,
     "anchor": "middle",
     "underline": true
    },
    {
     "op": "path",
     "id": "t0",
     "d": "M 100 450 L 100 600 L 300 600 Z",
     "color": "blue",
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "t0_ra",
     "d": "M 100 580 L 120 580 L 120 600",
     "color": "ink",
     "width": 3
    },
    {
     "op": "write",
     "id": "t0_a",
     "x": 75,
     "y": 510,
     "text": "a",
     "size": 34,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "t0_b",
     "x": 200,
     "y": 615,
     "text": "b",
     "size": 34,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "t0_c",
     "x": 215,
     "y": 495,
     "text": "c",
     "size": 34,
     "color": "red",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Build a Big Square",
   "say": "Now, imagine a large square where each side has length a plus b.",
