{
 "title": "Why the Pythagorean Theorem Works",
 "lang": "en",
 "steps": [
  {
   "title": "The Right Triangle",
   "say": "Let's start with a right triangle with legs a and b, and hypotenuse c.",
   "ops": [
    {
     "op": "write",
     "id": "t_main",
     "x": 800,
     "y": 60,
     "text": "Why Does a² + b² = c² Work?",
     "size": 52,
     "color": "ink",
     "anchor": "middle"
    },
    {
     "op": "path",
     "id": "tri_base",
     "d": "M 200 480 L 440 480 L 200 300 Z",
     "color": "blue",
     "width": 5,
     "fill": "blue"
    },
    {
     "op": "rect",
     "id": "tri_sq",
     "x": 200,
     "y": 450,
     "w": 30,
     "h": 30,
     "color": "ink",
     "width": 3
    },
    {
     "op": "write",
     "id": "lbl_a",
     "x": 160,
     "y": 380,
     "text": "a",
     "size": 36,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "lbl_b",
     "x": 310,
     "y": 500,
     "text": "b",
     "size": 36,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "lbl_c",
     "x": 340,
     "y": 370,
     "text": "c",
     "size": 36,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "exp_1",
     "x": 580,
     "y": 350,
     "text": "Can we prove that the area of the squares\non sides a and b equals the square on c?",
     "size": 36,
     "color": "ink"
    }
   ]
  },
  {
   "title": "Arrange 4 Triangles in a Square",
   "say": "Take four copies of this triangle and arrange them inside a large square of side a + b.",
