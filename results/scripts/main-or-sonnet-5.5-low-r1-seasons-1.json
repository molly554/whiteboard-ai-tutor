{
 "title": "Why We Have Seasons",
 "lang": "en",
 "steps": [
  {
   "title": "The question",
   "say": "Seasons come from the way Earth is tilted, not from how far we are from the Sun.",
   "ops": [
    {
     "id": "t1",
     "x": 800,
     "y": 50,
     "text": "Why We Have Seasons",
     "size": 56,
