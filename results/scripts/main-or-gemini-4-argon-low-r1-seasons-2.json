  {
   "title": "Why Tilt Changes Temperature",
   "say": "When tilted toward the Sun, sunlight hits directly and concentrates heat. When tilted away, light hits at a shallow angle and spreads out.",
   "ops": [
    {
     "op": "rect",
     "id": "box_ang",
     "x": 980,
     "y": 230,
     "w": 560,
     "h": 430,
     "color": "gray",
     "width": 3
    },
    {
     "op": "write",
     "id": "t_ang",
     "x": 1260,
     "y": 250,
     "text": "Sunlight Angle",
     "size": 36,
     "color": "ink",
     "anchor": "middle"
    },
    {
     "op": "line",
     "id": "r_dir1",
     "x1": 1020,
     "y1": 340,
     "x2": 1150,
     "y2": 340,
     "color": "red",
     "width": 4,
