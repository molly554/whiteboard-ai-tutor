{
 "title": "Why the Pythagorean Theorem Works",
 "lang": "en",
 "steps": [
  {
   "title": "1. The Right Triangle",
   "say": "Let's start with a right-angled triangle. It has two shorter legs, a and b, and the longest side, the hypotenuse c.",
   "ops": [
    {
     "op": "write",
     "id": "main_title",
     "x": 800,
     "y": 50,
     "text": "Why does a² + b² = c² work?",
     "size": 56,
     "color": "ink",
     "anchor": "middle"
    },
    {
     "op": "path",
     "id": "tri_0",
     "d": "M 100 420 L 100 580 L 220 580 Z",
     "color": "ink",
     "width": 5,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "ra_0",
     "d": "M 100 560 L 120 560 L 120 580",
     "color": "ink",
     "width": 3
    },
    {
     "op": "write",
     "id": "lbl_a0",
     "x": 75,
     "y": 480,
     "text": "a",
     "size": 36,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "lbl_b0",
     "x": 160,
     "y": 595,
     "text": "b",
     "size": 36,
     "color": "red",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "lbl_c0",
