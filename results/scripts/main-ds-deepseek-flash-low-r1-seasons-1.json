{
 "title": "Why Do We Have Seasons?",
 "lang": "en",
 "steps": [
  {
   "title": "The common misconception",
   "say": "Many people think seasons happen because Earth is closer to the Sun in summer. That's not the main reason.",
   "ops": [
    {
     "id": "title",
     "op": "write",
     "x": 800,
     "y": 60,
     "text": "Why Do We Have Seasons?",
     "size": 56,
     "anchor": "middle"
    },
    {
     "id": "misconception",
     "op": "write",
     "x": 80,
     "y": 150,
     "text": "Misconception: Earth is closer to the Sun in summer.",
     "size": 40,
     "color": "red"
    },
    {
     "id": "cross1",
     "op": "line",
     "x1": 100,
     "y1": 200,
     "x2": 140,
     "y2": 240,
     "color": "red",
     "width": 6
    },
    {
     "id": "cross2",
     "op": "line",
     "x1": 140,
     "y1": 200,
     "x2": 100,
     "y2": 240,
     "color": "red",
     "width": 6
    }
   ]
  },
  {
   "title": "Earth's tilt",
   "say": "Earth's axis is tilted about 23.5 degrees. This tilt is the key to seasons.",
