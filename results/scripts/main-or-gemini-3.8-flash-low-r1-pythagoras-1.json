    {
     "op": "erase",
     "ids": [
      "tri_base",
      "tri_sq",
      "lbl_a",
      "lbl_b",
      "lbl_c",
      "exp_1"
     ]
    },
    {
     "op": "write",
     "id": "fig1_title",
     "x": 420,
     "y": 160,
     "text": "Arrangement 1",
     "size": 38,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "rect",
     "id": "sq1_outer",
     "x": 200,
     "y": 240,
     "w": 440,
     "h": 440,
     "color": "ink",
     "width": 5
    },
    {
     "op": "path",
     "id": "tri1_1",
     "d": "M 200 540 L 200 680 L 500 680 Z",
     "color": "blue",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "tri1_2",
     "d": "M 500 680 L 640 680 L 640 380 Z",
     "color": "blue",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "tri1_3",
     "d": "M 640 380 L 640 240 L 340 240 Z",
     "color": "blue",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "tri1_4",
     "d": "M 340 240 L 200 240 L 200 540 Z",
     "color": "blue",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "write",
     "id": "lbl1_b1",
     "x": 340,
     "y": 700,
     "text": "b",
     "size": 32,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "lbl1_a1",
     "x": 560,
     "y": 700,
     "text": "a",
     "size": 32,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "lbl1_side",
     "x": 420,
     "y": 750,
     "text": "Total side = a + b",
     "size": 34,
     "color": "gray",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Uncovered Space is c²",
   "say": "The tilted inner space has four equal sides of length c, forming a square of area c².",
   "ops": [
    {
     "op": "path",
     "id": "c_square",
     "d": "M 200 540 L 500 680 L 640 380 L 340 240 Z",
     "color": "green",
     "width": 5,
     "fill": "green"
    },
    {
     "op": "write",
     "id": "lbl_c2",
     "x": 420,
     "y": 440,
     "text": "Area = c²",
     "size": 40,
     "color": "green",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "c_edge",
     "x": 370,
     "y": 590,
     "text": "c",
     "size": 32,
     "color": "green"
    }
   ]
  },
  {
   "title": "Rearrange into Two Rectangles",
   "say": "Now build an identical outer square of side a + b, but pair the four triangles into two rectangles.",
   "ops": [
    {
     "op": "write",
     "id": "fig2_title",
     "x": 1180,
     "y": 160,
     "text": "Arrangement 2",
     "size": 38,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "rect",
     "id": "sq2_outer",
     "x": 960,
     "y": 240,
     "w": 440,
     "h": 440,
     "color": "ink",
     "width": 5
    },
    {
     "op": "path",
     "id": "tri2_1",
     "d": "M 960 380 L 960 240 L 1260 240 Z",
     "color": "blue",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "tri2_2",
     "d": "M 960 380 L 1260 380 L 1260 240 Z",
     "color": "blue",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "tri2_3",
     "d": "M 1260 680 L 1260 380 L 1400 380 Z",
     "color": "blue",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "tri2_4",
