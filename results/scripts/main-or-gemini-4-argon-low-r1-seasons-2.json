  {
   "title": "Summary",
   "say": "So seasons happen because Earth's 23.5-degree tilt changes both the angle of sunlight and the length of daylight throughout the year.",
   "ops": [
    {
     "op": "rect",
     "id": "box_sum",
     "x": 140,
     "y": 710,
     "w": 1320,
     "h": 110,
