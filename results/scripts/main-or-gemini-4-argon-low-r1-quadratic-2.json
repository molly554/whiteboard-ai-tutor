    }
   ]
  },
  {
   "title": "Find Two Numbers",
   "say": "We just need two numbers that multiply to positive 6 and add up to negative 5.",
   "ops": [
    {
     "op": "rect",
     "id": "puzzle_box",
     "x": 850,
     "y": 240,
     "w": 620,
     "h": 220,
     "color": "blue",
     "fill": "blue"
    },
    {
     "op": "write",
     "id": "p_title",
     "x": 890,
     "y": 265,
