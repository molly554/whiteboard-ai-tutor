{
 "title": "Why Pythagoras works",
 "lang": "en",
 "steps": [
  {
   "title": "The claim",
   "say": "In a right triangle with legs a and b and hypotenuse c, the theorem says a² + b² = c². Let's see why, using areas.",
   "ops": [
    {
     "op": "write",
     "id": "title",
     "x": 60,
     "y": 40,
     "text": "Why a² + b² = c²",
     "size": 54
    },
    {
     "op": "line",
     "id": "t1",
     "x1": 200,
     "y1": 700,
     "x2": 600,
     "y2": 700,
     "color": "blue",
     "width": 5
    },
    {
     "op": "line",
     "id": "t2",
     "x1": 200,
     "y1": 700,
     "x2": 200,
     "y2": 400,
     "color": "blue",
     "width": 5
    },
    {
     "op": "line",
     "id": "t3",
     "x1": 200,
     "y1": 400,
     "x2": 600,
     "y2": 700,
     "color": "red",
     "width": 5
    },
    {
     "op": "write",
     "id": "lb",
     "x": 400,
     "y": 735,
     "text": "b",
     "size": 34,
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "la",
     "x": 140,
     "y": 530,
     "text": "a",
     "size": 34
    },
    {
     "op": "write",
     "id": "lc",
     "x": 430,
     "y": 510,
     "text": "c",
     "size": 34,
     "color": "red"
    }
   ]
  },
  {
   "title": "Big square",
   "say": "Take four copies of this triangle and arrange them inside a big square whose side is a + b.",
   "ops": [
    {
     "op": "rect",
     "id": "big",
     "x": 900,
     "y": 200,
     "w": 500,
     "h": 500,
     "color": "ink",
     "width": 5
    },
    {
     "op": "write",
     "id": "side",
     "x": 1150,
     "y": 725,
     "text": "side = a + b",
     "size": 32,
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Tilted square",
   "say": "Place the four triangles with their hypotenuses facing inward. The hole left in the middle is a tilted square with side c.",
   "ops": [
    {
     "op": "line",
     "id": "s1",
     "x1": 1200,
     "y1": 200,
     "x2": 1400,
     "y2": 400,
     "color": "red",
     "width": 5
    },
    {
     "op": "line",
     "id": "s2",
     "x1": 1400,
     "y1": 400,
     "x2": 1100,
     "y2": 700,
     "color": "red",
     "width": 5
    },
    {
     "op": "line",
     "id": "s3",
     "x1": 1100,
     "y1": 700,
     "x2": 900,
     "y2": 500,
     "color": "red",
     "width": 5
    },
    {
     "op": "line",
     "id": "s4",
     "x1": 900,
     "y1": 500,
     "x2": 1200,
     "y2": 200,
     "color": "red",
     "width": 5
    },
    {
     "op": "write",
     "id": "cc",
     "x": 1150,
     "y": 420,
     "text": "c²",
     "size": 44,
     "color": "red",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Area, way one",
   "say": "The big square's area is the tilted square plus four triangles: c² + 4·(ab/2) = c² + 2ab.",
   "ops": [
    {
     "op": "write",
     "id": "eq1",
     "x": 60,
     "y": 180,
     "text": "Area = c² + 2ab",
     "size": 40
    }
   ]
  },
  {
   "title": "Rearrange",
   "say": "Now rearrange the same four triangles into two rectangles in the corners. The leftover space is two squares, a² and b².",
   "ops": [
    {
     "op": "erase",
     "ids": [
      "s1",
      "s2",
      "s3",
      "s4",
      "cc",
      "side"
     ]
    },
    {
     "op": "line",
     "id": "v",
     "x1": 1100,
     "y1": 200,
     "x2": 1100,
     "y2": 700,
     "color": "gray",
     "width": 4
    },
    {
     "op": "line",
     "id": "h",
     "x1": 900,
     "y1": 400,
     "x2": 1400,
     "y2": 400,
     "color": "gray",
     "width": 4
    },
    {
     "op": "write",
     "id": "a2",
     "x": 1000,
     "y": 280,
     "text": "a²",
     "size": 44,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "b2",
     "x": 1250,
     "y": 520,
     "text": "b²",
     "size": 44,
     "color": "green",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Area, way two",
   "say": "So the same big square's area is also a² + b² + 2ab.",
   "ops": [
    {
     "op": "write",
     "id": "eq2",
     "x": 60,
     "y": 250,
     "text": "Area = a² + b² + 2ab",
     "size": 40
    }
   ]
  },
  {
   "title": "Compare",
   "say": "Both expressions describe the same area, so subtract 2ab from each side and we get a² + b² = c².",
   "ops": [
    {
     "op": "write",
     "id": "eq3",
     "x": 60,
     "y": 340,
     "text": "c² + 2ab = a² + b² + 2ab",
     "size": 36
    },
    {
     "op": "write",
     "id": "eq4",
     "x": 60,
     "y": 420,
     "text": "a² + b² = c²",
     "size": 50,
     "color": "green",
     "underline": true
    }
   ]
  }
 ]
}