{
 "title": "Why does price rise when demand rises?",
 "lang": "en",
 "steps": [
  {
   "title": "Shift of the curve",
   "say": "That arrow shows that at every price level, consumers now want to buy more quantity than before.",
   "ops": [
    {
     "op": "rect",
     "id": "shift_box",
     "x": 230,
     "y": 200,
     "w": 220,
     "h": 85,
     "color": "green",
     "width": 2
    },
    {
     "op": "erase",
     "ids": [
      "note3"
     ]
    },
    {
     "op": "write",
     "id": "note_shift",
     "x": 1200,
     "y": 600,
     "text": "The arrow shows a\nrightward shift: at every\nprice, buyers want more.",
     "size": 30,
     "color": "green"
    }
   ]
  },
  {
   "title": "New equilibrium",
   "say": "Because buyers compete for the available goods, the intersection with supply moves up to a higher price, P2.",
   "ops": [
    {
     "op": "erase",
     "ids": [
      "shift_box"
     ]
    },
    {
     "op": "ellipse",
     "id": "e2",
     "cx": 660,
     "cy": 427,
     "rx": 9,
     "ry": 9,
     "color": "red",
     "fill": "red"
    },
    {
     "op": "line",
     "id": "e2h",
     "x1": 200,
     "y1": 427,
     "x2": 660,
     "y2": 427,
     "color": "red",
     "width": 3,
     "dash": true
    },
    {
     "op": "line",
     "id": "e2v",
     "x1": 660,
     "y1": 427,
     "x2": 660,
     "y2": 720,
     "color": "red",
     "width": 3,
     "dash": true
    },
    {
     "op": "write",
     "id": "p2",
     "x": 130,
     "y": 409,
     "text": "P2",
     "size": 32,
     "anchor": "middle",
     "color": "red"
    },
    {
     "op": "write",
     "id": "q2",
     "x": 660,
     "y": 735,
     "text": "Q2",
     "size": 32,
     "anchor": "middle",
     "color": "red"
    },
    {
     "op": "line",
     "id": "p_rise_arrow",
     "x1": 80,
     "y1": 450,
     "x2": 80,
     "y2": 420,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "erase",
     "ids": [
      "note_shift"
     ]
    },
    {
     "op": "write",
     "id": "conclusion",
     "x": 1200,
     "y": 600,
     "text": "Result:\nPrice rises (P1 → P2)\nQuantity rises (Q1 → Q2)",
     "size": 30,
     "color": "red"
    }
   ]
  }
 ]
}