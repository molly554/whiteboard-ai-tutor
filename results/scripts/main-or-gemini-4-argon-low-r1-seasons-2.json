{
 "title": "Why Do We Have Seasons?",
 "lang": "en",
 "steps": [
  {
   "title": "The Real Reason",
   "say": "Many think seasons come from Earth's distance to the Sun, but the real reason is Earth's axial tilt.",
   "ops": [
    {
     "op": "write",
     "id": "t_main",
     "x": 800,
     "y": 50,
     "text": "Why Do We Have Seasons?",
     "size": 56,
     "anchor": "middle",
     "underline": true
    },
    {
     "op": "write",
     "id": "t_myth",
     "x": 200,
     "y": 130,
     "text": "NOT distance to the Sun",
     "size": 36,
     "color": "red"
    },
    {
     "op": "line",
     "id": "l_strike",
     "x1": 190,
     "y1": 152,
     "x2": 620,
     "y2": 152,
     "color": "red",
     "width": 4
    },
    {
     "op": "write",
     "id": "t_truth",
     "x": 900,
     "y": 130,
     "text": "YES: 23.5° Axial Tilt!",
     "size": 36,
     "color": "green"
    }
   ]
  },
  {
   "title": "Earth's Tilt",
   "say": "As Earth orbits the Sun, its spin axis is tilted by 23.5 degrees from vertical.",
   "ops": [
    {
     "op": "ellipse",
     "id": "e_tilt",
     "cx": 300,
     "cy": 450,
     "rx": 90,
     "ry": 90,
     "color": "blue",
     "fill": "blue"
    },
    {
     "op": "line",
     "id": "l_vert",
     "x1": 300,
     "y1": 310,
     "x2": 300,
     "y2": 590,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "op": "line",
     "id": "l_axis",
     "x1": 240,
     "y1": 575,
     "x2": 360,
     "y2": 325,
     "color": "ink",
     "width": 5,
     "arrow": true
    },
    {
     "op": "line",
     "id": "l_eq",
     "x1": 218,
     "y1": 410,
     "x2": 382,
     "y2": 490,
     "color": "blue",
     "width": 3,
     "dash": true
    },
    {
     "op": "path",
     "id": "p_arc",
     "d": "M 300 350 A 100 100 0 0 1 340 358",
     "color": "red",
     "width": 3
    },
    {
     "op": "write",
     "id": "t_deg",
     "x": 385,
     "y": 315,
     "text": "23.5° tilt",
     "size": 32,
     "color": "red"
    },
    {
     "op": "write",
     "id": "t_np",
     "x": 375,
     "y": 290,
     "text": "North Pole",
     "size": 28,
     "color": "ink"
    }
   ]
  },
  {
   "title": "Earth's Orbit",
   "say": "Importantly, this tilt always points in the same direction in space as Earth travels around the Sun.",
