{
 "title": "Why do we have seasons?",
 "lang": "en",
 "steps": [
  {
   "title": "Distance is not the cause",
   "say": "In northern summer, Earth is actually about 3% farther from the Sun. That gap is far too small to explain the heat, so distance cannot be the main cause.",
   "ops": [
    {
     "op": "erase",
     "ids": [
      "sun",
      "sunlabel",
      "orbit",
      "orbitlabel",
      "earth1",
      "axis1",
      "earth2",
      "axis2",
      "earth3",
      "axis3",
      "earth4",
      "axis4"
     ]
    },
    {
     "op": "write",
     "id": "dist",
     "x": 60,
     "y": 260,
     "text": "Northern summer: Earth is about 3% farther from the Sun.\nThat small gap cannot explain the heat.",
     "size": 36
    },
    {
     "op": "write",
     "id": "distwrong",
     "x": 60,
     "y": 360,
     "text": "So distance is NOT the main cause.",
     "size": 40,
     "color": "red"
    }
   ]
  },
  {
   "title": "Tilt changes the angle of sunlight",
   "say": "The northern half leans toward the Sun, so sunlight hits it more directly. The same light is spread over less ground, which makes it hotter.",
