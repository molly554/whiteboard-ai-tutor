{
 "title": "Solving x² − 5x + 6 = 0",
 "lang": "en",
 "steps": [
  {
   "title": "The problem",
   "say": "We want the values of x that make x squared minus 5x plus 6 equal to zero.",
   "ops": [
    {
     "id": "t1",
     "type": "write",
     "op": "write",
     "x": 800,
     "y": 50,
     "text": "Solve a quadratic",
     "size": 56,
     "anchor": "middle",
     "color": "blue"
    },
    {
     "id": "eq1",
     "op": "write",
     "x": 800,
     "y": 200,
     "text": "x² − 5x + 6 = 0",
     "size": 56,
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Try the formula",
   "say": "We could use the quadratic formula, with a = 1, b = −5 and c = 6.",
   "ops": [
    {
     "id": "f1",
     "op": "write",
     "x": 200,
     "y": 340,
     "text": "x = (−b ± √(b² − 4ac)) / 2a",
     "size": 40
    },
    {
     "id": "f2",
     "op": "write",
     "x": 200,
     "y": 420,
     "text": "a = 1,  b = −5,  c = 6",
     "size": 36,
     "color": "gray"
    }
   ]
  },
  {
   "title": "Too heavy, switch",
   "say": "That works, but it is a lot of machinery. Since the numbers are small, factoring is simpler, so let's erase this and switch.",
   "ops": [
    {
     "id": "x1",
     "op": "line",
     "x1": 180,
     "y1": 330,
     "x2": 1000,
     "y2": 500,
     "color": "red",
     "width": 5
    },
    {
     "id": "n1",
     "op": "write",
     "x": 200,
     "y": 540,
     "text": "Too heavy! Try factoring.",
     "size": 40,
     "color": "red"
    }
   ]
  },
  {
   "title": "Clear the board",
   "say": "We wipe the formula away and keep only the original equation.",
   "ops": [
    {
     "op": "erase",
     "ids": [
      "f1",
      "f2",
      "x1",
      "n1"
     ]
    }
   ]
  },
  {
   "title": "Find the pair",
   "say": "We need two numbers that multiply to 6 and add to −5. Those are −2 and −3.",
   "ops": [
    {
     "id": "p1",
     "op": "write",
     "x": 200,
     "y": 340,
     "text": "multiply to  6",
     "size": 40
    },
    {
     "id": "p2",
     "op": "write",
     "x": 200,
     "y": 410,
     "text": "add to  −5",
     "size": 40
    },
    {
     "id": "p3",
     "op": "write",
     "x": 200,
     "y": 500,
     "text": "−2 and −3",
     "size": 44,
     "color": "green"
    }
   ]
  },
  {
   "title": "Factor",
   "say": "So the equation factors into x minus 2 times x minus 3 equals zero.",
   "ops": [
    {
     "id": "fa1",
     "op": "write",
     "x": 1000,
     "y": 340,
     "text": "(x − 2)(x − 3) = 0",
     "size": 48,
     "color": "blue"
    }
   ]
  },
  {
   "title": "Zero product rule",
   "say": "A product is zero only if one factor is zero, so x minus 2 is zero or x minus 3 is zero.",
   "ops": [
    {
     "id": "z1",
     "op": "write",
     "x": 1000,
     "y": 450,
     "text": "x − 2 = 0   or   x − 3 = 0",
     "size": 38
    },
    {
     "id": "z2",
     "op": "write",
     "x": 1000,
     "y": 540,
     "text": "x = 2",
     "size": 44,
     "color": "green"
    },
    {
     "id": "z3",
     "op": "write",
     "x": 1250,
     "y": 540,
     "text": "x = 3",
     "size": 44,
     "color": "green"
    }
   ]
  },
  {
   "title": "Answer",
   "say": "The solutions are x equals 2 and x equals 3.",
   "ops": [
    {
     "id": "ans",
     "op": "write",
