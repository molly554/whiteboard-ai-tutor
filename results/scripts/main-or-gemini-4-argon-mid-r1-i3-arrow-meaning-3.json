     "y2": 470,
     "color": "green",
     "width": 5,
     "arrow": true
    },
    {
     "op": "ellipse",
     "id": "pt_new",
     "cx": 740,
     "cy": 470,
     "rx": 8,
     "ry": 8,
     "color": "green",
     "fill": "green"
    },
    {
     "op": "line",
