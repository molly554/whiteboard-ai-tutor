    {
     "op": "ellipse",
     "id": "e1",
     "cx": 300,
     "cy": 520,
     "rx": 50,
     "ry": 50,
     "color": "blue",
     "fill": "blue"
    },
    {
     "op": "line",
     "id": "ax1",
     "x1": 275,
     "y1": 590,
     "x2": 325,
     "y2": 450,
     "color": "ink",
     "width": 4
    },
    {
     "op": "write",
     "id": "tilt",
     "x": 120,
     "y": 620,
     "text": "tilt 23.5°",
     "size": 32
    },
    {
     "op": "ellipse",
     "id": "e2",
     "cx": 1300,
     "cy": 520,
     "rx": 50,
     "ry": 50,
     "color": "blue",
