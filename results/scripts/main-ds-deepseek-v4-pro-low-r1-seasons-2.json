{
 "title": "Why Do We Have Seasons?",
 "lang": "en",
 "steps": [
  {
   "title": "The Earth's Tilt",
   "say": "First, let's remember that the Earth's axis is tilted, not straight up and down.",
   "ops": [
    {
     "op": "write",
     "id": "title_tilt",
     "x": 80,
     "y": 80,
     "text": "1. Earth's Tilt",
     "size": 56,
     "color": "ink",
     "anchor": "start"
    },
    {
     "op": "write",
     "id": "label_tilt",
     "x": 80,
     "y": 160,
     "text": "Earth's axis is tilted about 23.5°",
     "size": 40,
     "color": "ink",
     "anchor": "start"
    },
    {
     "op": "path",
     "id": "tilt_line",
     "d": "M 400 200 L 400 500",
     "color": "blue",
     "width": 5
    },
    {
     "op": "line",
     "id": "tilt_arrow",
     "x1": 400,
     "y1": 500,
     "x2": 460,
     "y2": 500,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "write",
     "id": "tilt_angle_label",
     "x": 470,
     "y": 490,
     "text": "23.5°",
     "size": 34,
     "color": "red",
     "anchor": "start"
    }
   ]
  },
  {
