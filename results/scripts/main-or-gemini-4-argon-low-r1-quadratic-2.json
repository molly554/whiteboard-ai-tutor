    {
     "op": "write",
     "id": "m1_s2",
     "x": 120,
     "y": 410,
     "text": "x² − 5x + (5/2)² = −6 + 25/4",
     "size": 40
    },
    {
     "op": "write",
     "id": "m1_note",
     "x": 850,
     "y": 415,
     "text": "← Fractions are messy...",
     "size": 34,
     "color": "red"
    }
   ]
  },
  {
   "title": "Switch to a Simpler Method",
