{
 "title": "Why the Pythagorean Theorem Works",
 "lang": "en",
 "steps": [
  {
   "title": "The theorem",
   "say": "For a right triangle with legs a and b and hypotenuse c, a squared plus b squared equals c squared.",
   "ops": [
    {
     "id": "title",
     "x": 800,
     "y": 50,
     "text": "Why does a² + b² = c² ?",
     "size": 54,
     "anchor": "middle"
    },
    {
     "id": "eq",
     "x": 800,
     "y": 140,
     "text": "a² + b² = c²",
     "size": 48,
     "anchor": "middle",
     "color": "blue"
    }
   ]
  },
  {
   "title": "Draw the triangle",
   "say": "Start with a right triangle. The two shorter sides are a and b, and the longest side is c.",
   "ops": [
    {
     "id": "tri",
     "d": "M 300 700 L 300 450 L 600 700 Z",
     "color": "ink",
     "width": 6
    },
    {
     "id": "right",
     "d": "M 300 670 L 330 670 L 330 700",
     "color": "gray",
     "width": 4
    },
    {
     "id": "lbl_a",
     "x": 265,
     "y": 560,
     "text": "a",
     "size": 44,
     "color": "red",
     "anchor": "middle"
    },
    {
     "id": "lbl_b",
     "x": 450,
     "y": 720,
     "text": "b",
     "size": 44,
     "color": "green",
     "anchor": "middle"
    },
    {
     "id": "lbl_c",
     "x": 470,
     "y": 555,
     "text": "c",
     "size": 44,
     "color": "blue",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Build squares on the legs",
   "say": "Build a square on each leg. The red square has area a squared, and the green square has area b squared.",
   "ops": [
    {
     "id": "sq_a",
     "x": 120,
     "y": 450,
     "w": 180,
     "h": 250,
     "color": "red",
     "width": 4,
     "fill": "red"
    },
    {
     "id": "sq_b",
     "x": 300,
     "y": 700,
     "w": 300,
     "h": 180,
     "color": "green",
     "width": 4,
     "fill": "green"
    },
    {
     "id": "area_a",
     "x": 210,
     "y": 560,
     "text": "a²",
     "size": 40,
     "color": "red",
     "anchor": "middle"
    },
    {
     "id": "area_b",
     "x": 450,
     "y": 790,
     "text": "b²",
     "size": 40,
     "color": "green",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Build the square on the hypotenuse",
   "say": "The square on the hypotenuse has area c squared. We want to show the two small squares together fill exactly this big square.",
   "ops": [
    {
     "id": "sq_c",
     "d": "M 600 700 L 900 700 L 1050 450 L 750 450 Z",
     "color": "blue",
     "width": 4,
     "fill": "blue"
    },
    {
     "id": "area_c",
     "x": 825,
     "y": 575,
     "text": "c²",
     "size": 44,
     "color": "blue",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Rearrange the pieces",
   "say": "Cut the two small squares into pieces and slide them into the big square. They fit perfectly, with no gaps or overlaps.",
   "ops": [
    {
     "id": "cut1",
     "x1": 210,
     "y1": 450,
     "x2": 210,
     "y2": 700,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "id": "cut2",
     "x1": 120,
     "y1": 575,
     "x2": 300,
     "y2": 575,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "id": "cut3",
     "x1": 450,
     "y1": 700,
     "x2": 450,
     "y2": 880,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "id": "cut4",
     "x1": 300,
     "y1": 790,
     "x2": 600,
     "y2": 790,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "id": "arrow1",
     "x1": 300,
     "y1": 575,
     "x2": 620,
     "y2": 575,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "id": "arrow2",
     "x1": 450,
     "y1": 790,
     "x2": 750,
     "y2": 790,
     "color": "green",
     "width": 4,
     "arrow": true
    }
   ]
  },
  {
   "title": "Conclusion",
   "say": "Since the pieces of a squared plus b squared exactly cover c squared, the areas must be equal. That is why a squared plus b squared equals c squared.",
   "ops": [
    {
     "id": "conclusion",
     "x": 800,
     "y": 860,
     "text": "Area(a²) + Area(b²) = Area(c²)",
     "size": 40,
     "anchor": "middle",
     "color": "blue"
    }
   ]
  }
 ]
}