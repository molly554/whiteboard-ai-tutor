    },
    {
     "op": "write",
     "id": "june_s",
     "x": 320,
     "y": 655,
     "text": "South tilts AWAY = Winter",
     "size": 30,
     "color": "blue",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "December: Northern Winter",
   "say": "Six months later in December, Earth is on the other side of the Sun. Because the tilt direction stays the same, the North now tilts away.",
