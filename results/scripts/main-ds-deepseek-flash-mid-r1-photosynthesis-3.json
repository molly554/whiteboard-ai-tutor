   ]
  },
  {
   "title": "给出答案",
   "say": "所以，光合作用发生在植物细胞的叶绿体中。",
   "ops": [
    {
     "op": "write",
     "id": "answer",
     "x": 80,
     "y": 760,
     "text": "答案：植物细胞的叶绿体",
     "size": 44,
     "color": "red"
    }
   ]
  }
 ]
