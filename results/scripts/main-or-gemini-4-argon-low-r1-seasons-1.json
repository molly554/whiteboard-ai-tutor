{
 "title": "Why Do We Have Seasons?",
 "lang": "en",
 "steps": [
  {
   "title": "Common Myth vs. The Truth",
   "say": "Many people think seasons happen because Earth gets closer to the Sun, but the real reason is Earth's tilted axis.",
   "ops": [
    {
     "op": "write",
     "id": "main_title",
     "x": 800,
     "y": 50,
     "text": "Why Do We Have Seasons?",
     "size": 56,
     "anchor": "middle",
     "underline": true
    },
    {
     "op": "write",
     "id": "myth_txt",
     "x": 100,
     "y": 140,
     "text": "Myth: Closer to the Sun = Summer",
     "size": 36,
     "color": "gray"
    },
    {
     "op": "line",
     "id": "myth_strike",
     "x1": 95,
     "y1": 162,
     "x2": 685,
     "y2": 162,
     "color": "red",
     "width": 4
    },
    {
     "op": "write",
     "id": "fact_txt",
     "x": 820,
     "y": 140,
     "text": "Truth: Earth's 23.5 deg Axial Tilt!",
     "size": 38,
     "color": "blue"
    }
   ]
  },
  {
   "title": "Earth's Orbit Around the Sun",
   "say": "As Earth orbits the Sun once a year, its axis always points in the exact same direction in space.",
   "ops": [
    {
     "op": "ellipse",
     "id": "orbit_path",
     "cx": 480,
     "cy": 540,
     "rx": 360,
     "ry": 140,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "op": "ellipse",
     "id": "sun_body",
     "cx": 480,
     "cy": 540,
     "rx": 65,
     "ry": 65,
     "color": "red",
     "fill": "red"
    },
    {
     "op": "write",
     "id": "sun_lbl",
     "x": 480,
     "y": 522,
     "text": "Sun",
     "size": 36,
     "anchor": "middle",
     "color": "ink"
    }
   ]
  },
  {
   "title": "June: Northern Summer",
   "say": "In June, the Northern Hemisphere tilts toward the Sun, giving it summer, while the South has winter.",
