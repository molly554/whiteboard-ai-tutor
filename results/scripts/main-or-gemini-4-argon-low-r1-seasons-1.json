  {
   "title": "Why Does Tilt Change Temperature?",
   "say": "Finally, let's look at why tilting toward the Sun actually makes it warmer: sunlight angle and daylight hours.",
   "ops": [
    {
     "op": "rect",
     "id": "zoom_box",
     "x": 1000,
     "y": 230,
     "w": 550,
     "h": 610,
     "color": "gray",
     "width": 3
    },
    {
     "op": "write",
     "id": "zoom_title",
     "x": 1275,
     "y": 255,
     "text": "Why Tilt = Warmth",
     "size": 38,
     "anchor": "middle",
     "underline": true
    },
    {
     "op": "write",
     "id": "direct_lbl",
     "x": 1030,
     "y": 330,
     "text": "1. Direct Ray (Summer):",
     "size": 32,
     "color": "red"
    },
    {
     "op": "line",
