     "id": "tilt_text",
     "op": "write",
     "x": 430,
     "y": 480,
     "text": "23.5°",
     "size": 28,
     "color": "red"
    }
   ]
  },
  {
   "title": "Sunlight angle",
   "say": "When sunlight hits at a steeper angle, it's concentrated and warmer. At a shallower angle, it spreads out and is cooler.",
   "ops": [
    {
     "id": "sun",
     "op": "ellipse",
     "cx": 800,
     "cy": 200,
     "rx": 60,
     "ry": 60,
     "color": "red",
     "fill": "red"
    },
    {
     "id": "sun_label",
     "op": "write",
     "x": 800,
     "y": 130,
     "text": "Sun",
     "size": 36,
     "anchor": "middle"
    },
    {
     "id": "ray1",
     "op": "line",
     "x1": 860,
     "y1": 200,
     "x2": 1000,
     "y2": 350,
     "color": "red",
     "width": 3,
     "arrow": true
    },
