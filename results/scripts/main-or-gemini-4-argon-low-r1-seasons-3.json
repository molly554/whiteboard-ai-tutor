    },
    {
     "op": "write",
     "id": "s_sum",
     "x": 92,
     "y": 530,
     "text": "S",
     "size": 28,
     "color": "ink"
    }
   ]
  },
  {
   "title": "June: Tilted Toward the Sun",
   "say": "In June, the Northern Hemisphere tilts toward the Sun, catching more sunlight. This brings summer to the North and winter to the South.",
   "ops": [
    {
     "op": "line",
     "id": "ray_s1",
     "x1": 340,
     "y1": 435,
     "x2": 210,
     "y2": 435,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "line",
     "id": "ray_s2",
     "x1": 340,
     "y1": 485,
     "x2": 210,
     "y2": 485,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "write",
     "id": "june_lbl",
     "x": 150,
     "y": 585,
     "text": "June",
     "size": 36,
     "color": "ink",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "june_n_lbl",
     "x": 150,
     "y": 635,
