{
 "title": "Supply, Demand and Price",
 "lang": "en",
 "steps": [
  {
   "title": "The axes",
   "say": "Price goes up the vertical axis and quantity along the horizontal axis. Every market can be drawn this way.",
   "ops": [
    {
     "op": "write",
     "id": "title",
     "x": 60,
     "y": 40,
     "text": "Supply, Demand and Price",
     "size": 54
    },
    {
     "op": "widget",
     "id": "sd",
     "kind": "supply-demand",
     "params": {
      "show": [
       "axes"
      ],
      "interactive": "none"
     }
    }
   ]
  },
  {
   "title": "Demand",
   "say": "Demand slopes down: the higher the price, the less buyers want to buy.",
   "ops": [
    {
     "op": "widget",
     "id": "sd",
     "kind": "supply-demand",
     "params": {
      "show": [
       "axes",
       "demand"
      ],
      "interactive": "none"
     }
    }
   ]
  },
  {
   "title": "Supply",
   "say": "Supply slopes up: the higher the price, the more sellers are willing to offer.",
   "ops": [
    {
     "op": "widget",
     "id": "sd",
     "kind": "supply-demand",
     "params": {
      "show": [
       "axes",
       "demand",
       "supply"
      ],
      "interactive": "none"
     }
    }
   ]
  },
  {
   "title": "Equilibrium",
   "say": "Where the curves cross, buyers and sellers agree. This equilibrium sets the market price at 5 and the quantity at 5.",
   "ops": [
    {
     "op": "widget",
     "id": "sd",
     "kind": "supply-demand",
     "params": {
      "show": [
       "axes",
       "demand",
       "supply",
       "equilibrium",
       "readout"
      ],
      "interactive": "none"
     },
     "expect": {
      "price": "same",
      "quantity": "same"
     }
    }
   ]
  },
  {
   "title": "Demand rises",
   "say": "If demand rises, the demand curve moves right. Buyers compete, so the price and the quantity both go up.",
   "ops": [
    {
     "op": "widget",
     "id": "sd",
     "kind": "supply-demand",
     "params": {
      "show": [
       "axes",
       "demand",
       "supply",
       "equilibrium",
       "readout"
      ],
      "demandShift": 2,
      "interactive": "none"
     },
     "expect": {
      "price": "up",
      "quantity": "up"
     }
    }
   ]
  },
  {
   "title": "Reset",
   "say": "Let's go back to the starting market before your quiz.",
   "ops": [
    {
     "op": "widget",
     "id": "sd",
     "kind": "supply-demand",
     "params": {
      "show": [
       "axes",
       "demand",
       "supply",
       "equilibrium",
       "readout"
      ],
      "demandShift": 0,
      "interactive": "none"
     },
     "expect": {
      "price": "same",
      "quantity": "same"
     }
    }
   ]
  },
  {
   "title": "Quiz: supply falls",
   "say": "Now supply falls, so the supply curve moves left. Drag the dot to where you think the new equilibrium is.",
   "ops": [
    {
     "op": "widget",
     "id": "sd",
     "kind": "supply-demand",
     "params": {
      "show": [
       "axes",
       "demand",
       "supply",
       "equilibrium",
       "readout"
      ],
      "supplyShift": -2,
      "ask": "equilibrium",
      "interactive": "none"
     }
    }
   ]
  }
 ]
}