     "x": 1000,
     "y": 240,
     "w": 350,
     "h": 350,
     "color": "ink",
     "width": 5
    },
    {
     "op": "path",
     "id": "s2_t1",
     "d": "M 1150 240 L 1350 240 L 1150 390 Z",
     "color": "ink",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "s2_t2",
     "d": "M 1350 390 L 1150 390 L 1350 240 Z",
     "color": "ink",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "s2_t3",
     "d": "M 1000 390 L 1150 390 L 1000 590 Z",
     "color": "ink",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "s2_t4",
     "d": "M 1150 590 L 1000 590 L 1150 390 Z",
