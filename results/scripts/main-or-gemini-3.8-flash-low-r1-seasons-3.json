  {
   "title": "Spring and Autumn Equinoxes",
   "say": "During March and September, neither hemisphere tilts toward or away from the Sun, giving us moderate temperatures.",
   "ops": [
    {
     "op": "ellipse",
     "id": "earth_top",
     "cx": 800,
     "cy": 280,
     "rx": 35,
     "ry": 35,
     "color": "ink",
     "fill": "blue"
    },
    {
     "op": "write",
     "id": "lbl_top",
     "x": 800,
     "y": 235,
     "text": "March Equinox (Spring / Autumn)",
     "size": 26,
     "color": "green",
     "anchor": "middle"
    },
    {
     "op": "ellipse",
     "id": "earth_bot",
     "cx": 800,
