{
 "title": "Why the Pythagorean Theorem Works",
 "lang": "en",
 "steps": [
  {
   "title": "1. The Right Triangle",
   "say": "Let's start with a right-angled triangle with legs a and b, and hypotenuse c.",
   "ops": [
    {
     "op": "write",
     "id": "main_title",
     "x": 800,
     "y": 50,
     "text": "Why does a² + b² = c² work?",
     "size": 56,
     "anchor": "middle",
     "underline": true
    },
    {
     "op": "path",
     "id": "t0",
     "d": "M 100 450 L 100 300 L 300 450 Z",
     "color": "ink",
     "width": 5,
     "fill": "blue"
    },
    {
     "op": "rect",
     "id": "r0",
     "x": 100,
     "y": 430,
     "w": 20,
     "h": 20,
     "color": "ink",
     "width": 3
    },
    {
     "op": "write",
     "id": "la0",
     "x": 70,
     "y": 355,
     "text": "a",
     "size": 36,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "lb0",
     "x": 200,
     "y": 465,
     "text": "b",
     "size": 36,
     "color": "red",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "lc0",
     "x": 215,
     "y": 340,
     "text": "c",
     "size": 36,
     "color": "green",
     "anchor": "middle"
    }
   ]
  },
  {
