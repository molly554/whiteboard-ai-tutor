{
 "title": "Why Do We Have Seasons?",
 "lang": "en",
 "steps": [
  {
   "title": "A Common Myth",
   "say": "Many people think seasons happen because Earth gets closer to the Sun in summer, but that's actually a myth!",
   "ops": [
    {
     "op": "write",
     "id": "main_title",
     "x": 800,
     "y": 50,
     "text": "Why Do We Have Seasons?",
     "size": 56,
     "anchor": "middle",
     "underline": true
    },
    {
     "op": "write",
     "id": "myth_txt",
     "x": 800,
     "y": 140,
     "text": "Myth: Closer to the Sun = Warmer",
     "size": 36,
     "color": "gray",
     "anchor": "middle"
    },
    {
     "op": "line",
     "id": "myth_strike",
     "x1": 480,
     "y1": 162,
     "x2": 1120,
     "y2": 162,
     "color": "red",
     "width": 5
    },
    {
     "op": "ellipse",
     "id": "orbit",
     "cx": 800,
     "cy": 470,
     "rx": 480,
     "ry": 190,
     "color": "gray",
     "dash": true,
     "width": 4
    },
    {
     "op": "ellipse",
     "id": "sun",
     "cx": 800,
     "cy": 470,
     "rx": 65,
     "ry": 65,
     "color": "red",
     "fill": "red"
    },
    {
     "op": "write",
     "id": "sun_lbl",
     "x": 800,
     "y": 452,
     "text": "Sun",
     "size": 32,
     "color": "red",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Earth's Tilt",
