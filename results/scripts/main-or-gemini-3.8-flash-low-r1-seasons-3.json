{
 "title": "Why Do We Have Seasons?",
 "lang": "en",
 "steps": [
  {
   "title": "Topic & Common Myth",
   "say": "Many people assume seasons happen because Earth gets closer or farther from the Sun. That is actually a myth!",
   "ops": [
    {
     "op": "write",
     "id": "main_title",
     "x": 800,
     "y": 60,
     "text": "Why Do We Have Seasons?",
     "size": 52,
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "myth_text",
     "x": 800,
     "y": 130,
     "text": "Common Myth: Distance from the Sun changes throughout the year.",
     "size": 30,
     "color": "gray",
     "anchor": "middle"
    },
    {
     "op": "line",
     "id": "strike_myth",
     "x1": 340,
     "y1": 145,
     "x2": 1260,
     "y2": 145,
     "color": "red",
     "width": 4
    }
   ]
  },
  {
   "title": "The Real Cause: Earth's Tilt",
   "say": "The real reason is Earth's axial tilt. Our planet is tilted by 23.5 degrees as it orbits the Sun.",
   "ops": [
    {
     "op": "write",
     "id": "real_cause",
     "x": 800,
     "y": 180,
     "text": "Real Cause: Earth's Axial Tilt (23.5°)",
     "size": 36,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "ellipse",
     "id": "sun_core",
     "cx": 800,
     "cy": 500,
     "rx": 70,
     "ry": 70,
     "color": "red",
     "fill": "red"
    },
    {
     "op": "write",
     "id": "sun_lbl",
     "x": 800,
     "y": 485,
     "text": "Sun",
     "size": 32,
     "color": "ink",
     "anchor": "middle"
    },
    {
     "op": "ellipse",
     "id": "orbit_path",
     "cx": 800,
     "cy": 500,
     "rx": 540,
     "ry": 220,
     "color": "gray",
     "width": 2,
     "dash": true
    }
   ]
  },
  {
   "title": "June: Northern Summer",
   "say": "In June, the Northern Hemisphere tilts toward the Sun. Sunlight hits it directly, creating longer days and summer.",
