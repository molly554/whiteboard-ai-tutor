  },
  {
   "title": "Spring and Autumn",
   "say": "In Spring and Fall, neither hemisphere tilts toward the Sun, giving us mild temperatures and equal days. That's why we have four seasons!",
   "ops": [
    {
     "op": "write",
     "id": "mar_lbl",
     "x": 420,
     "y": 290,
     "text": "March (Spring / Fall)",
     "size": 28,
     "color": "green",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "sep_lbl",
     "x": 420,
     "y": 605,
     "text": "Sept (Fall / Spring)",
     "size": 28,
     "color": "green",
     "anchor": "middle"
    },
    {
     "op": "rect",
     "id": "sum_box",
     "x": 150,
