    {
     "op": "path",
     "id": "t2_1",
     "d": "M 900 180 L 1020 180 L 900 460 Z",
     "color": "blue",
     "fill": "blue",
     "width": 2
    },
    {
     "op": "path",
     "id": "t2_2",
     "d": "M 1020 180 L 1020 460 L 900 460 Z",
     "color": "blue",
     "fill": "blue",
     "width": 2
    },
    {
     "op": "path",
     "id": "t2_3",
     "d": "M 1020 460 L 1300 460 L 1020 580 Z",
     "color": "blue",
     "fill": "blue",
     "width": 2
    },
    {
     "op": "path",
     "id": "t2_4",
     "d": "M 1300 460 L 1300 580 L 1020 580 Z",
     "color": "blue",
     "fill": "blue",
     "width": 2
    },
    {
     "op": "rect",
     "id": "sq_a",
     "x": 900,
     "y": 460,
     "w": 120,
     "h": 120,
     "color": "green",
     "width": 4,
     "fill": "green"
    },
    {
     "op": "write",
     "id": "a_sq_lbl",
     "x": 960,
     "y": 505,
     "text": "a²",
     "size": 36,
     "color": "green",
     "anchor": "middle"
    },
    {
     "op": "rect",
     "id": "sq_b",
     "x": 1020,
     "y": 180,
     "w": 280,
     "h": 280,
     "color": "green",
     "width": 4,
     "fill": "green"
    },
    {
     "op": "write",
     "id": "b_sq_lbl",
     "x": 1160,
     "y": 300,
     "text": "b²",
     "size": 48,
     "color": "green",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Subtract the Triangles",
   "say": "Both large frames have equal area and contain the exact same four blue triangles.",
   "ops": [
    {
     "op": "write",
     "id": "step5_text",
     "x": 800,
     "y": 640,
     "text": "Total Area 1 = Total Area 2\n4 Triangles + c² = 4 Triangles + a² + b²",
     "size": 38,
     "color": "ink",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "The Conclusion",
   "say": "Subtract the four blue triangles from both sides, and we are left with a squared plus b squared equals c squared.",
   "ops": [
    {
     "op": "line",
     "id": "strike1",
     "x1": 340,
     "y1": 690,
     "x2": 520,
     "y2": 690,
     "color": "red",
     "width": 4
    },
    {
     "op": "line",
     "id": "strike2",
     "x1": 620,
     "y1": 690,
     "x2": 800,
     "y2": 690,
     "color": "red",
     "width": 4
    },
    {
     "op": "rect",
     "id": "final_box",
     "x": 620,
     "y": 740,
     "w": 360,
     "h": 90,
     "color": "red",
     "width": 4
    },
    {
     "op": "write",
     "id": "final_formula",
     "x": 800,
     "y": 760,
     "text": "a² + b² = c²",
     "size": 48,
     "color": "red",
     "anchor": "middle"
    }
   ]
  }
 ]
}