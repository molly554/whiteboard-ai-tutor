{
 "title": "Solving x² - 5x + 6 = 0",
 "lang": "en",
 "steps": [
  {
   "title": "Problem Statement",
   "say": "Let's solve this quadratic equation. We can always start with the standard quadratic formula.",
   "ops": [
    {
     "op": "write",
     "id": "t_eq",
     "x": 800,
     "y": 60,
     "text": "Solve:  x² - 5x + 6 = 0",
     "size": 52,
