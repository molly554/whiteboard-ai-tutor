{
 "title": "Why the Pythagorean Theorem Works",
 "lang": "en",
 "steps": [
  {
   "title": "The Right Triangle",
   "say": "Let's take any right triangle with legs a and b, and hypotenuse c.",
   "ops": [
    {
     "op": "write",
     "id": "title",
     "x": 60,
     "y": 40,
     "text": "Visual Proof: a² + b² = c²",
     "size": 52
    },
    {
     "op": "path",
     "id": "tri",
     "d": "M 200 450 L 200 250 L 500 450 Z",
     "color": "blue",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "sq_corner",
     "d": "M 200 420 L 230 420 L 230 450",
     "color": "blue",
     "width": 3
    },
    {
     "op": "write",
     "id": "lbl_a",
     "x": 160,
     "y": 330,
     "text": "a",
     "size": 38,
     "color": "blue"
    },
    {
     "op": "write",
     "id": "lbl_b",
     "x": 340,
     "y": 465,
     "text": "b",
     "size": 38,
     "color": "blue"
    },
    {
     "op": "write",
     "id": "lbl_c",
     "x": 370,
     "y": 320,
     "text": "c",
     "size": 38,
     "color": "blue"
    }
   ]
  },
  {
   "title": "Arrangement 1: Four Triangles",
   "say": "We can arrange four identical copies of this triangle to form a large square of side a + b, leaving an inner tilted square.",
   "ops": [
    {
     "op": "erase",
     "ids": [
      "tri",
      "sq_corner",
      "lbl_a",
      "lbl_b",
      "lbl_c"
     ]
    },
    {
     "op": "write",
     "id": "header1",
     "x": 180,
     "y": 140,
     "text": "Box 1: Side (a + b)",
     "size": 36,
     "color": "ink"
    },
    {
     "op": "rect",
     "id": "outer1",
     "x": 100,
     "y": 200,
     "w": 440,
     "h": 440,
     "color": "ink",
     "width": 4
    },
    {
     "op": "path",
     "id": "inner_sq",
     "d": "M 100 340 L 400 200 L 540 500 L 240 640 Z",
     "color": "green",
     "width": 4,
     "fill": "green"
    },
    {
     "op": "write",
     "id": "c_sq_lbl",
     "x": 305,
     "y": 405,
     "text": "c²",
     "size": 48,
     "color": "green",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "side1_a",
     "x": 100,
     "y": 655,
     "text": "a",
     "size": 30,
     "color": "blue"
    },
    {
     "op": "write",
     "id": "side1_b",
     "x": 370,
     "y": 655,
     "text": "b",
     "size": 30,
     "color": "blue"
    }
   ]
  },
  {
   "title": "Area of Arrangement 1",
   "say": "The inner square has side c, so its area is c². The total area is four triangles plus c².",
   "ops": [
    {
     "op": "write",
     "id": "eq1",
     "x": 100,
     "y": 720,
     "text": "Total Area = 4 Triangles + c²",
     "size": 34,
     "color": "green"
    }
   ]
  },
  {
   "title": "Arrangement 2: Rearranging",
   "say": "Now, take the exact same outer square of side a + b, but rearrange the four triangles into two rectangles.",
   "ops": [
    {
     "op": "write",
     "id": "header2",
     "x": 880,
     "y": 140,
     "text": "Box 2: Same Side (a + b)",
     "size": 36,
     "color": "ink"
    },
    {
     "op": "rect",
     "id": "outer2",
     "x": 800,
     "y": 200,
     "w": 440,
     "h": 440,
     "color": "ink",
     "width": 4
    },
    {
     "op": "line",
     "id": "split_v",
     "x1": 940,
     "y1": 200,
     "x2": 940,
     "y2": 640,
     "color": "gray",
     "width": 2,
     "dash": [
      6,
      6
     ]
    },
    {
     "op": "line",
     "id": "split_h",
     "x1": 800,
     "y1": 500,
     "x2": 1240,
     "y2": 500,
     "color": "gray",
     "width": 2,
     "dash": [
      6,
      6
     ]
    },
    {
     "op": "path",
     "id": "diag1",
     "d": "M 800 200 L 940 500",
     "color": "blue",
     "width": 3
    },
    {
     "op": "path",
     "id": "diag2",
     "d": "M 940 500 L 1240 640",
     "color": "blue",
     "width": 3
    },
    {
     "op": "rect",
     "id": "sq_a",
     "x": 800,
     "y": 500,
     "w": 140,
     "h": 140,
     "color": "red",
     "width": 4,
     "fill": "red"
    },
    {
     "op": "write",
     "id": "lbl_a2",
     "x": 855,
     "y": 555,
     "text": "a²",
     "size": 40,
     "color": "red",
     "anchor": "middle"
    },
    {
     "op": "rect",
     "id": "sq_b",
     "x": 940,
     "y": 200,
     "w": 300,
     "h": 300,
     "color": "red",
     "width": 4,
     "fill": "red"
    },
    {
     "op": "write",
     "id": "lbl_b2",
     "x": 1075,
     "y": 335,
     "text": "b²",
     "size": 48,
     "color": "red",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Area of Arrangement 2",
   "say": "The leftover space in this box consists of two separate squares of areas a² and b².",
   "ops": [
    {
     "op": "write",
     "id": "eq2",
     "x": 800,
     "y": 720,
     "text": "Total Area = 4 Triangles + a² + b²",
     "size": 34,
     "color": "red"
    }
   ]
  },
  {
   "title": "Conclusion",
   "say": "Since both large boxes have identical area and both contain four identical triangles, the leftover areas must be equal: a² + b² = c².",
   "ops": [
    {
     "op": "rect",
     "id": "box_summary",
     "x": 480,
     "y": 780,
     "w": 400,
     "h": 80,
     "color": "ink",
     "width": 3
    },
    {
     "op": "write",
     "id": "summary",
     "x": 680,
     "y": 795,
     "text": "a² + b² = c²",
     "size": 48,
     "color": "ink",
     "anchor": "middle"
    }
   ]
  }
 ]
}