{
 "title": "Why do we have seasons?",
 "lang": "en",
 "steps": [
  {
   "title": "The distance objection",
   "say": "Yes, northern summer does happen near Earth's farthest point from the Sun. But that distance change is tiny compared with the tilt effect.",
   "ops": [
    {
     "op": "write",
     "id": "aphelion",
     "x": 840,
     "y": 100,
     "text": "Yes — north summer is near aphelion,\nbut distance changes sunlight only ~7%.\nThe tilt matters far more.",
     "size": 32,
     "color": "blue"
    }
   ]
  },
  {
   "title": "Tilt changes the sunlight angle",
   "say": "When the north pole leans toward the Sun, sunlight strikes the northern hemisphere more directly. Leaning away, the same light is spread out.",
