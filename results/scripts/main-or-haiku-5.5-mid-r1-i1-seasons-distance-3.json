    {
     "op": "ellipse",
     "id": "sun",
     "cx": 200,
     "cy": 600,
     "rx": 60,
     "ry": 60,
     "color": "red",
     "width": 5,
     "fill": "red"
    },
    {
     "op": "write",
     "id": "sunlabel",
     "x": 200,
     "y": 675,
     "text": "Sun",
     "size": 30,
     "anchor": "middle"
    },
    {
     "op": "line",
     "id": "r1",
     "x1": 300,
     "y1": 500,
     "x2": 640,
     "y2": 500,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
