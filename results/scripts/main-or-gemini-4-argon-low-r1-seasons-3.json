     "size": 30,
     "color": "red",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Why Tilt Changes Temperature",
   "say": "When tilted toward the Sun, sunlight hits straight on, concentrating heat into a small area. When tilted away, the same light spreads out and is weaker.",
   "ops": [
    {
     "op": "line",
     "id": "div_line",
     "x1": 850,
     "y1": 210,
     "x2": 850,
     "y2": 720,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "op": "write",
     "id": "angle_title",
     "x": 1220,
     "y": 215,
     "text": "How Sunlight Hits Earth",
     "size": 38,
     "color": "ink",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "dir_lbl",
     "x": 900,
     "y": 285,
     "text": "1. Direct Light (Summer)",
     "size": 34,
     "color": "red"
    },
    {
     "op": "line",
     "id": "dir_r1",
     "x1": 940,
     "y1": 355,
     "x2": 1180,
     "y2": 355,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "line",
     "id": "dir_r2",
     "x1": 940,
     "y1": 405,
     "x2": 1180,
     "y2": 405,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "line",
     "id": "surf_dir",
     "x1": 1200,
     "y1": 330,
     "x2": 1200,
     "y2": 430,
     "color": "green",
     "width": 8
    },
    {
     "op": "write",
     "id": "dir_desc",
     "x": 1235,
     "y": 345,
     "text": "Concentrated\n= Warmer",
     "size": 30,
     "color": "red"
    },
    {
     "op": "write",
     "id": "ang_lbl",
     "x": 900,
     "y": 485,
