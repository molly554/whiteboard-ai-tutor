    {
     "op": "line",
     "id": "s",
     "x1": 320,
     "y1": 700,
     "x2": 1100,
     "y2": 240,
     "color": "red",
     "width": 5
    },
    {
     "op": "write",
     "id": "label_s",
     "x": 1110,
     "y": 230,
     "text": "S",
     "size": 32,
     "color": "red"
    },
    {
     "op": "ellipse",
     "id": "eq1",
     "cx": 640,
     "cy": 500,
     "rx": 8,
     "ry": 8,
     "fill": "ink"
    },
    {
     "op": "write",
     "id": "label_eq1",
     "x": 650,
     "y": 470,
     "text": "E1",
     "size": 28,
     "color": "ink"
    }
   ]
  },
  {
   "title": "Demand shifts right",
   "say": "When demand rises, the whole demand curve shifts to the right, from D1 to D2.",
