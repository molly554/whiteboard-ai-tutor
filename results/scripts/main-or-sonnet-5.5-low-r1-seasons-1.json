    },
    {
     "op": "line",
     "id": "ax2",
     "x1": 1275,
     "y1": 590,
     "x2": 1325,
     "y2": 450,
     "color": "ink",
     "width": 4
    }
   ]
  },
  {
   "title": "June side",
   "say": "In June the northern half leans toward the Sun, so sunlight hits it more directly and days are longer.",
   "ops": [
    {
     "op": "write",
     "id": "jun",
     "x": 1300,
     "y": 680,
     "text": "June",
     "size": 40,
     "anchor": "middle",
     "color": "red"
    },
    {
     "op": "write",
     "id": "junn",
     "x": 1300,
     "y": 740,
     "text": "North: summer",
     "size": 32,
     "anchor": "middle"
    },
    {
     "op": "line",
     "id": "ray1",
     "x1": 870,
     "y1": 500,
     "x2": 1210,
     "y2": 500,
     "color": "red",
     "arrow": true,
     "width": 4
    }
   ]
  },
  {
   "title": "December side",
   "say": "Six months later the northern half leans away, so sunlight is slanted and weaker, and days are shorter.",
   "ops": [
    {
     "op": "write",
     "id": "dec",
     "x": 300,
     "y": 680,
     "text": "December",
     "size": 40,
     "anchor": "middle",
     "color": "blue"
    },
    {
     "op": "write",
     "id": "decn",
     "x": 300,
     "y": 740,
     "text": "North: winter",
     "size": 32,
     "anchor": "middle"
    },
    {
     "op": "line",
     "id": "ray2",
     "x1": 730,
     "y1": 500,
     "x2": 370,
     "y2": 500,
     "color": "red",
     "arrow": true,
     "width": 4
    }
   ]
  },
  {
   "title": "Key idea",
   "say": "So the tilt changes how directly sunlight hits us, and that gives us seasons. When it is summer in the north, it is winter in the south.",
   "ops": [
    {
     "op": "write",
     "id": "key",
     "x": 800,
