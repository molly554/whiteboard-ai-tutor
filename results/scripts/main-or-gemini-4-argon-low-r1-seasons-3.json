    {
     "op": "ellipse",
     "id": "earth_sum",
     "cx": 150,
     "cy": 460,
     "rx": 48,
     "ry": 48,
     "color": "blue",
     "fill": "blue"
    },
    {
     "op": "line",
     "id": "vert_ref",
     "x1": 150,
     "y1": 370,
     "x2": 150,
     "y2": 550,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "op": "line",
     "id": "axis_sum",
     "x1": 182,
     "y1": 385,
     "x2": 118,
     "y2": 535,
     "color": "ink",
     "width": 5
    },
    {
     "op": "line",
     "id": "eq_sum",
     "x1": 106,
     "y1": 441,
     "x2": 194,
     "y2": 479,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "op": "write",
     "id": "tilt_lbl",
     "x": 150,
     "y": 325,
     "text": "23.5° Tilt",
     "size": 30,
     "color": "ink",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "n_sum",
     "x": 198,
