    {
     "op": "rect",
     "id": "thylakoid-1",
     "x": 980,
     "y": 320,
     "w": 140,
     "h": 24,
     "color": "green",
     "width": 4
    },
    {
     "op": "rect",
     "id": "thylakoid-2",
     "x": 1000,
     "y": 360,
     "w": 140,
     "h": 24,
     "color": "green",
     "width": 4
    },
    {
     "op": "rect",
     "id": "thylakoid-3",
