{
 "title": "Solving x² − 5x + 6 = 0",
 "lang": "en",
 "steps": [
  {
   "title": "Problem Statement",
   "say": "We want to solve the quadratic equation x² − 5x + 6 = 0.",
   "ops": [
    {
     "op": "write",
     "id": "main_title",
     "x": 80,
     "y": 50,
     "text": "Solve: x² − 5x + 6 = 0",
     "size": 52,
     "color": "ink"
    },
    {
     "op": "line",
     "id": "header_line",
     "x1": 80,
     "y1": 115,
     "x2": 1520,
     "y2": 115,
     "color": "gray",
     "width": 2
    },
    {
     "op": "write",
     "id": "given_eq",
     "x": 80,
     "y": 140,
     "text": "x² − 5x + 6 = 0",
     "size": 44,
     "color": "blue"
    }
   ]
  },
  {
   "title": "Method 1: Quadratic Formula",
   "say": "Our standard reflex might be using the quadratic formula with a = 1, b = -5, and c = 6.",
   "ops": [
    {
     "op": "write",
     "id": "m1_title",
     "x": 80,
     "y": 220,
     "text": "Method 1: Quadratic Formula",
     "size": 34,
     "color": "gray"
    },
    {
     "op": "write",
     "id": "m1_formula",
     "x": 80,
     "y": 270,
     "text": "x = [ −b ± √(b² − 4ac) ] / (2a)",
     "size": 30,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "m1_coeffs",
     "x": 80,
     "y": 320,
     "text": "a = 1,  b = −5,  c = 6",
     "size": 28,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "m1_sub",
     "x": 80,
     "y": 365,
     "text": "x = [ 5 ± √(25 − 24) ] / 2",
     "size": 30,
     "color": "gray"
    }
   ]
  },
  {
   "title": "Pause & Pivot",
   "say": "Wait, calculating square roots here is unnecessary work. Let's switch to a much simpler method!",
   "ops": [
    {
     "op": "rect",
     "id": "m1_box",
     "x": 60,
     "y": 210,
     "w": 560,
     "h": 210,
     "color": "gray",
     "dash": true
    },
    {
     "op": "write",
     "id": "wait_text",
     "x": 80,
     "y": 450,
     "text": "Wait! That's too tedious...",
     "size": 32,
     "color": "red"
    },
    {
     "op": "write",
     "id": "pivot_label",
     "x": 520,
     "y": 320,
     "text": "Switch to Factoring ➔",
     "size": 28,
     "color": "red"
    },
    {
     "op": "line",
     "id": "arrow_switch",
     "x1": 500,
     "y1": 360,
     "x2": 760,
     "y2": 360,
     "color": "red",
     "width": 4,
     "arrow": true
    }
   ]
  },
  {
   "title": "Method 2: Factoring",
   "say": "Let's switch to factoring: we just need two numbers that multiply to 6 and add to -5.",
   "ops": [
    {
     "op": "write",
     "id": "m2_title",
     "x": 800,
     "y": 140,
     "text": "Method 2: Factoring (Simpler & Faster)",
     "size": 36,
     "color": "blue"
    },
    {
     "op": "write",
     "id": "m2_condition",
     "x": 800,
     "y": 200,
     "text": "Find two numbers p and q such that:",
     "size": 30,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "m2_prod",
     "x": 830,
     "y": 245,
     "text": "•  p · q = +6   (constant term)",
     "size": 28,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "m2_sum",
     "x": 830,
     "y": 285,
     "text": "•  p + q = −5   (middle coefficient)",
     "size": 28,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "m2_pair",
     "x": 830,
     "y": 340,
     "text": "Numbers:  −2  and  −3",
     "size": 32,
     "color": "green"
    },
    {
     "op": "write",
     "id": "m2_check",
     "x": 830,
     "y": 385,
     "text": "(−2) × (−3) = 6   and   (−2) + (−3) = −5  ✓",
     "size": 28,
     "color": "gray"
    }
   ]
  },
  {
   "title": "Factor the Quadratic",
   "say": "Now we can rewrite the left side directly as the product of two linear factors.",
   "ops": [
    {
     "op": "write",
     "id": "factor_label",
     "x": 800,
     "y": 450,
     "text": "Rewrite equation in factored form:",
     "size": 30,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "factored_eq",
     "x": 800,
     "y": 500,
     "text": "(x − 2)(x − 3) = 0",
     "size": 44,
     "color": "blue"
    }
   ]
  },
  {
   "title": "Solve for x",
   "say": "Setting each factor to zero gives our solutions directly: x = 2 and x = 3.",
   "ops": [
    {
     "op": "write",
     "id": "zpp_label",
     "x": 800,
     "y": 580,
     "text": "Zero-Product Property:",
     "size": 28,
     "color": "gray"
    },
    {
     "op": "write",
     "id": "root1",
     "x": 820,
     "y": 620,
     "text": "x − 2 = 0   ⟹   x = 2",
     "size": 34,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "root2",
     "x": 820,
     "y": 670,
     "text": "x − 3 = 0   ⟹   x = 3",
     "size": 34,
     "color": "ink"
    },
    {
     "op": "rect",
     "id": "ans_box",
     "x": 790,
     "y": 730,
     "w": 460,
     "h": 65,
     "color": "green",
     "width": 3,
     "fill": "green"
    },
    {
     "op": "write",
     "id": "final_ans",
     "x": 820,
     "y": 745,
     "text": "Answer: x = 2  or  x = 3",
     "size": 34,
     "color": "green"
    }
   ]
  }
 ]
}