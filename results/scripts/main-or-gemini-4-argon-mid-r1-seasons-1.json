    {
     "op": "erase",
     "ids": [
      "myth_txt",
      "myth_strike"
     ]
    },
    {
     "op": "write",
     "id": "real_txt",
     "x": 800,
     "y": 140,
     "text": "Real Reason: Earth's 23.5° Axial Tilt",
     "size": 40,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "ellipse",
     "id": "earth_l",
     "cx": 320,
     "cy": 470,
     "rx": 55,
     "ry": 55,
     "color": "blue",
