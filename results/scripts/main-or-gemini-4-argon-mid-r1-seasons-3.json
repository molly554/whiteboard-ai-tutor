{
 "title": "Why Do We Have Seasons?",
 "lang": "en",
 "steps": [
  {
   "title": "Common Misconception",
   "say": "Many people think seasons happen because Earth gets closer to the Sun in summer, but Earth's orbit is actually nearly circular.",
   "ops": [
    {
     "op": "write",
     "id": "main_title",
     "x": 800,
     "y": 50,
     "text": "Why Do We Have Seasons?",
     "size": 56,
     "anchor": "middle",
     "underline": true
    },
    {
     "op": "write",
     "id": "myth_txt",
     "x": 800,
     "y": 240,
     "text": "Myth: Closer to the Sun = Summer",
     "size": 44,
     "color": "gray",
     "anchor": "middle"
    },
    {
     "op": "line",
     "id": "myth_strike",
     "x1": 430,
     "y1": 265,
     "x2": 1170,
     "y2": 265,
     "color": "red",
     "width": 6
    },
    {
     "op": "write",
     "id": "fact_txt",
     "x": 800,
     "y": 380,
     "text": "Fact: Earth's orbit is nearly a circle!",
     "size": 44,
     "color": "green",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "real_cause",
     "x": 800,
     "y": 520,
     "text": "Real Cause: Earth's 23.5° Axial Tilt",
     "size": 50,
     "color": "blue",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Earth's Axial Tilt",
   "say": "As Earth orbits the Sun, its axis is tilted at 23.5 degrees, and this tilt always points in the same direction in space.",
   "ops": [
    {
     "op": "erase",
     "ids": [
      "myth_txt",
      "myth_strike",
      "fact_txt",
      "real_cause"
     ]
    },
    {
