     "d": "M 450 240 L 600 240 L 450 440 Z",
     "color": "ink",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "s1_t2",
     "d": "M 800 240 L 800 390 L 600 240 Z",
     "color": "ink",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "s1_t3",
     "d": "M 800 590 L 650 590 L 800 390 Z",
     "color": "ink",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "s1_t4",
     "d": "M 450 590 L 450 440 L 650 590 Z",
     "color": "ink",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "write",
     "id": "s1_la",
     "x": 525,
     "y": 195,
     "text": "a",
     "size": 32,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "s1_lb",
     "x": 700,
     "y": 195,
     "text": "b",
     "size": 32,
     "color": "red",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "s1_la2",
     "x": 425,
     "y": 500,
     "text": "a",
     "size": 32,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "s1_lb2",
     "x": 425,
     "y": 325,
     "text": "b",
     "size": 32,
     "color": "red",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "3. The Tilted Empty Space",
   "say": "Look at the empty space in the middle. Each side is the hypotenuse c, so this empty space is a square of area c²!",
   "ops": [
    {
     "op": "path",
     "id": "s1_c2",
     "d": "M 600 240 L 800 390 L 650 590 L 450 440 Z",
     "color": "green",
     "width": 5,
     "fill": "green"
    },
    {
     "op": "write",
     "id": "s1_lc",
     "x": 540,
     "y": 345,
     "text": "c",
     "size": 32,
     "color": "green",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "s1_area",
     "x": 625,
     "y": 395,
     "text": "c²",
     "size": 48,
     "color": "green",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "s1_cap",
     "x": 625,
     "y": 620,
     "text": "Empty area = c²",
     "size": 36,
     "color": "green",
     "anchor": "middle"
    }
   ]
  },
  {
