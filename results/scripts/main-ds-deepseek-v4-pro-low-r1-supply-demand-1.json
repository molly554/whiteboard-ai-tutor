   "ops": [
    {
     "op": "line",
     "id": "p1_line",
     "x1": 640,
     "y1": 500,
     "x2": 140,
     "y2": 500,
     "color": "ink",
     "width": 3,
     "dash": true
    },
    {
     "op": "line",
     "id": "p2_line",
     "x1": 760,
     "y1": 440,
     "x2": 140,
     "y2": 440,
     "color": "ink",
     "width": 3,
     "dash": true
    },
    {
     "op": "write",
     "id": "label_p1",
     "x": 120,
     "y": 510,
     "text": "P1",
     "size": 28,
     "anchor": "middle",
     "color": "ink"
    },
    {
     "op": "write",
     "id": "label_p2",
     "x": 120,
     "y": 450,
     "text": "P2",
     "size": 28,
     "anchor": "middle",
     "color": "ink"
    },
    {
     "op": "write",
     "id": "price_up",
     "x": 400,
     "y": 160,
     "text": "P2 > P1",
     "size": 36,
     "anchor": "middle",
     "color": "red"
    }
   ]
  },
  {
   "title": "Conclusion",
   "say": "So when demand rises, the price increases, and the quantity sold also increases.",
   "ops": [
    {
     "op": "write",
     "id": "conclusion",
     "x": 80,
