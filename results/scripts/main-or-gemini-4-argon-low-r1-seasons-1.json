     "text": "JUNE\nNorth: Summer\nSouth: Winter",
     "size": 28,
     "anchor": "middle",
     "color": "ink"
    }
   ]
  },
  {
   "title": "December: Northern Winter",
   "say": "Six months later in December, the axis still tilts the same way, so the North tilts away from the Sun and gets winter.",
