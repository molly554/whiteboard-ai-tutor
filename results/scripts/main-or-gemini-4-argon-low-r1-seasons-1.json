     "rx": 45,
     "ry": 45,
     "color": "blue",
     "fill": "blue"
    },
    {
     "op": "line",
     "id": "axis_june",
     "x1": 93,
     "y1": 603,
     "x2": 147,
     "y2": 477,
     "color": "ink",
     "width": 4,
     "arrow": true
    },
    {
     "op": "line",
     "id": "eq_june",
     "x1": 79,
     "y1": 522,
     "x2": 161,
     "y2": 558,
     "color": "ink",
     "width": 2,
     "dash": true
    },
    {
     "op": "line",
     "id": "ray_j1",
     "x1": 395,
     "y1": 515,
     "x2": 180,
     "y2": 515,
     "color": "red",
     "width": 3,
     "arrow": true
