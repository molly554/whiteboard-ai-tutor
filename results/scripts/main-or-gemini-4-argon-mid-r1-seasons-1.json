     "dash": true,
     "width": 3
    },
    {
     "op": "line",
     "id": "axis_l",
     "x1": 285,
     "y1": 550,
     "x2": 355,
     "y2": 390,
     "color": "ink",
     "width": 5
    },
    {
     "op": "line",
     "id": "eq_l",
     "x1": 270,
     "y1": 448,
     "x2": 370,
     "y2": 492,
     "color": "blue",
     "dash": true,
     "width": 3
    },
    {
     "op": "write",
