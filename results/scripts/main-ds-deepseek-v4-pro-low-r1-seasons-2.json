     "size": 36,
     "color": "ink",
     "anchor": "start"
    }
   ]
  },
  {
   "title": "Winter in the North",
   "say": "When the Northern Hemisphere tilts away from the Sun, sunlight is more spread out and days are shorter.",
   "ops": [
    {
     "op": "write",
     "id": "title_winter",
     "x": 80,
     "y": 80,
     "text": "4. Winter in the North",
     "size": 56,
     "color": "ink",
     "anchor": "start"
    },
    {
     "op": "ellipse",
     "id": "sun_winter",
     "cx": 1200,
     "cy": 450,
     "rx": 45,
     "ry": 45,
     "color": "red",
     "fill": "red",
     "width": 3
    },
    {
     "op": "ellipse",
     "id": "earth_winter",
     "cx": 500,
     "cy": 450,
     "rx": 40,
     "ry": 40,
     "color": "blue",
     "fill": "blue",
     "width": 3
    },
    {
     "op": "line",
     "id": "tilt_winter",
     "x1": 500,
     "y1": 410,
     "x2": 500,
     "y2": 490,
     "color": "blue",
     "width": 5
    },
    {
     "op": "line",
     "id": "sunlight_winter",
     "x1": 1155,
     "y1": 450,
     "x2": 540,
     "y2": 450,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "write",
     "id": "south_label",
     "x": 500,
     "y": 510,
     "text": "S",
     "size": 32,
     "color": "ink",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "winter_note",
     "x": 80,
     "y": 600,
     "text": "Northern hemisphere tilted away from the Sun\n→ less direct sunlight, shorter days",
     "size": 36,
     "color": "ink",
     "anchor": "start"
    }
   ]
  },
  {
   "title": "Spring and Autumn",
   "say": "During spring and autumn, neither hemisphere tilts strongly toward the Sun, so we get milder weather.",
   "ops": [
    {
     "op": "write",
     "id": "title_spring",
     "x": 80,
     "y": 80,
     "text": "5. Spring and Autumn",
     "size": 56,
     "color": "ink",
     "anchor": "start"
    },
    {
     "op": "ellipse",
     "id": "sun_spring",
     "cx": 1200,
     "cy": 450,
     "rx": 45,
     "ry": 45,
     "color": "red",
     "fill": "red",
     "width": 3
    },
    {
     "op": "ellipse",
     "id": "earth_spring",
     "cx": 500,
     "cy": 450,
     "rx": 40,
     "ry": 40,
     "color": "blue",
     "fill": "blue",
     "width": 3
    },
    {
     "op": "line",
     "id": "tilt_spring",
     "x1": 500,
     "y1": 410,
     "x2": 500,
     "y2": 490,
     "color": "blue",
     "width": 5
    },
    {
     "op": "write",
     "id": "spring_note",
     "x": 80,
     "y": 600,
     "text": "Neither hemisphere tilted strongly toward the Sun\n→ milder weather, roughly equal day and night",
     "size": 36,
     "color": "ink",
     "anchor": "start"
    }
   ]
  },
  {
   "title": "The Reason",
   "say": "So seasons are caused by Earth's tilted axis and its orbit around the Sun, not by distance from the Sun.",
   "ops": [
    {
     "op": "write",
     "id": "title_reason",
     "x": 80,
     "y": 80,
     "text": "6. The Reason",
     "size": 56,
     "color": "ink",
     "anchor": "start"
    },
    {
     "op": "write",
     "id": "reason_text",
     "x": 80,
     "y": 180,
     "text": "Seasons are caused by:\n• Earth's 23.5° tilt\n• Earth's orbit around the Sun\n• Not by Earth's distance from the Sun",
     "size": 40,
     "color": "ink",
     "anchor": "start"
    }
   ]
  }
 ]
}