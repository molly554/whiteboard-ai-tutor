     "text": "North",
     "size": 30,
     "anchor": "middle",
     "color": "blue"
    },
    {
     "op": "write",
     "id": "tiltexp",
     "x": 1000,
     "y": 430,
     "text": "Northern summer: the north leans\ntoward the Sun. Sunlight hits it\nmore directly, so the ground heats\nmore, over less area.",
     "size": 32
    }
   ]
  },
  {
   "title": "The other half of the year",
   "say": "Six months later, the southern half leans toward the Sun, so it is summer there while the north is in winter.",
   "ops": [
    {
     "op": "write",
     "id": "south",
     "x": 60,
     "y": 790,
     "text": "Six months later the south leans toward the Sun, and it is summer there.",
     "size": 32,
     "color": "green"
    }
   ]
  }
 ]
