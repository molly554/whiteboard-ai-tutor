    },
    {
     "op": "write",
     "id": "p_add",
     "x": 920,
     "y": 385,
     "text": "p + q = −5   (middle coeff.)",
     "size": 34
    }
   ]
  },
  {
   "title": "Write in Factored Form",
   "say": "Negative 2 and negative 3 work! (−2)×(−3) = 6, and (−2)+(−3) = −5. So we factor it as (x − 2)(x − 3) = 0.",
   "ops": [
    {
     "op": "write",
     "id": "p_ans",
     "x": 890,
     "y": 490,
     "text": "Try −2 and −3:  (−2)(−3) = 6,  −2 − 3 = −5  ✓",
     "size": 32,
     "color": "green"
    },
    {
     "op": "write",
     "id": "f_step",
     "x": 120,
     "y": 360,
     "text": "(x − 2)(x − 3) = 0",
     "size": 44,
     "color": "ink"
