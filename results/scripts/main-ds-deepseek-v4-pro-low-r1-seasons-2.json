     "cy": 450,
     "rx": 30,
     "ry": 30,
     "color": "blue",
     "fill": "blue",
     "width": 3
    },
    {
     "op": "write",
     "id": "earth_label",
     "x": 240,
     "y": 500,
     "text": "Earth",
     "size": 36,
     "color": "blue",
     "anchor": "start"
    }
   ]
  },
  {
   "title": "Summer in the North",
   "say": "When the Northern Hemisphere tilts toward the Sun, it gets more direct sunlight and longer days.",
   "ops": [
    {
     "op": "write",
     "id": "title_summer",
     "x": 80,
     "y": 80,
     "text": "3. Summer in the North",
     "size": 56,
     "color": "ink",
     "anchor": "start"
    },
    {
     "op": "ellipse",
     "id": "sun_summer",
     "cx": 1200,
     "cy": 450,
     "rx": 45,
     "ry": 45,
     "color": "red",
     "fill": "red",
     "width": 3
    },
    {
     "op": "ellipse",
     "id": "earth_summer",
     "cx": 500,
     "cy": 450,
     "rx": 40,
     "ry": 40,
     "color": "blue",
     "fill": "blue",
     "width": 3
    },
    {
     "op": "line",
     "id": "tilt_summer",
     "x1": 500,
     "y1": 410,
     "x2": 500,
     "y2": 490,
     "color": "blue",
     "width": 5
    },
    {
     "op": "line",
     "id": "sunlight_summer",
     "x1": 1155,
     "y1": 450,
     "x2": 540,
     "y2": 450,
     "color": "red",
     "width": 4,
     "arrow": true
    },
