{
 "title": "Why Pythagoras Works",
 "lang": "en",
 "steps": [
  {
   "title": "The claim",
   "say": "In a right triangle, the squares on the two short sides add up to the square on the long side.",
   "ops": [
    {
     "id": "t1",
     "x": 800,
     "y": 50,
     "text": "Pythagorean Theorem",
     "size": 56,
     "anchor": "middle",
     "op": "write",
     "color": "blue"
    },
    {
     "id": "tri1",
     "op": "path",
     "d": "M 250 700 L 250 400 L 650 700 Z",
     "width": 5
    },
    {
     "id": "la",
     "op": "write",
     "x": 170,
     "y": 520,
     "text": "a",
     "size": 36
    },
    {
     "id": "lb",
     "op": "write",
     "x": 440,
     "y": 730,
     "text": "b",
     "size": 36
    },
    {
     "id": "lc",
     "op": "write",
     "x": 490,
     "y": 500,
     "text": "c",
     "size": 36,
     "color": "red"
    },
    {
     "id": "eq1",
     "op": "write",
     "x": 900,
     "y": 400,
     "text": "a² + b² = c²",
     "size": 56,
     "color": "red"
    }
   ]
  },
  {
   "title": "Build a big square",
   "say": "Take four copies of the triangle and arrange them inside a square whose side is a plus b.",
   "ops": [
    {
     "id": "e1",
     "op": "erase",
     "ids": [
      "tri1",
      "la",
      "lb",
      "lc",
      "eq1"
     ]
    },
    {
     "id": "big",
     "op": "rect",
     "x": 300,
     "y": 200,
     "w": 500,
     "h": 500,
     "width": 5
    },
    {
     "id": "cap1",
     "op": "write",
     "x": 550,
     "y": 740,
     "text": "side = a + b",
     "size": 34,
     "anchor": "middle",
     "color": "gray"
    }
   ]
  },
  {
   "title": "Tilted square inside",
   "say": "Place the four triangles in the corners. The hole left in the middle is a tilted square with side c.",
   "ops": [
    {
     "id": "q",
     "op": "path",
     "d": "M 560 200 L 800 460 L 540 700 L 300 440 Z",
     "color": "red",
     "width": 5
    },
    {
     "id": "cl",
     "op": "write",
     "x": 690,
     "y": 420,
     "text": "c",
     "size": 36,
     "color": "red"
    }
   ]
  },
  {
   "title": "Area, way one",
   "say": "The big square has area a plus b squared. It is four triangles plus the middle square c squared.",
   "ops": [
    {
     "id": "w1",
     "op": "write",
     "x": 900,
     "y": 250,
     "text": "Big area = (a+b)²",
     "size": 40
    },
    {
     "id": "w2",
     "op": "write",
     "x": 900,
     "y": 330,
     "text": "= 4 · ½ab + c²",
     "size": 40
    },
    {
     "id": "w3",
     "op": "write",
     "x": 900,
     "y": 410,
     "text": "= 2ab + c²",
     "size": 40
    }
   ]
  },
  {
   "title": "Area, way two",
   "say": "Expanding the square directly gives a squared plus two a b plus b squared.",
   "ops": [
    {
     "id": "w4",
     "op": "write",
     "x": 900,
     "y": 520,
     "text": "Also (a+b)² = a² + 2ab + b²",
     "size": 40
    }
   ]
  },
  {
   "title": "Compare",
   "say": "Both expressions describe the same area, so we set them equal.",
   "ops": [
    {
     "id": "w5",
     "op": "write",
     "x": 900,
     "y": 630,
     "text": "a² + 2ab + b² = 2ab + c²",
     "size": 40
    }
   ]
  },
  {
   "title": "Cancel",
   "say": "Subtract two a b from both sides and what remains is the theorem.",
   "ops": [
    {
     "id": "er",
     "op": "erase",
     "ids": [
      "w1",
      "w2",
      "w3",
      "w4",
      "w5"
     ]
    },
    {
     "id": "fin",
     "op": "write",
     "x": 1050,
     "y": 400,
     "text": "a² + b² = c²",
     "size": 60,
     "color": "red",
     "anchor": "middle"
    },
    {
     "id": "fin2",
     "op": "write",
     "x": 1050,
     "y": 500,
     "text": "The 2ab cancels!",
     "size": 36,
     "anchor": "middle",
     "color": "green"
    }
   ]
  }
 ]
}