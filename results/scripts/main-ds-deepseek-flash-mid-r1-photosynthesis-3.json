     "y2": 340,
     "color": "gray",
     "width": 3,
     "arrow": true
    },
    {
     "op": "write",
     "id": "stroma-label",
     "x": 1040,
     "y": 500,
     "text": "基质",
     "size": 32,
     "color": "blue"
