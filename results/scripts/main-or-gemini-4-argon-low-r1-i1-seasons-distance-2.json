{
 "title": "Why Distance Doesn't Rule Seasons",
 "lang": "en",
 "steps": [
  {
   "title": "Distance barely changes",
   "say": "Yes, in July Earth is farthest from the Sun, but that distance only changes by about 3 percent — an almost invisible difference in heat.",
   "ops": [
    {
     "op": "write",
     "id": "dist_fact1",
     "x": 850,
     "y": 40,
     "text": "Jan (closest): 147 million km",
     "size": 34,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "dist_fact2",
     "x": 850,
     "y": 90,
     "text": "July (farthest): 152 million km",
     "size": 34,
     "color": "ink"
    },
    {
     "op": "write",
     "id": "dist_diff",
     "x": 850,
     "y": 145,
