     "size": 32,
     "color": "red"
    }
   ]
  },
  {
   "title": "Summer vs winter",
   "say": "In summer, your hemisphere tilts toward the Sun, so sunlight hits at a steeper angle. In winter, it tilts away, so sunlight is more spread out.",
   "ops": [
    {
     "id": "summer_label",
     "op": "write",
     "x": 80,
     "y": 600,
     "text": "Summer: tilts toward Sun",
     "size": 36,
     "color": "red"
    },
    {
     "id": "winter_label",
     "op": "write",
     "x": 80,
     "y": 660,
     "text": "Winter: tilts away from Sun",
     "size": 36,
     "color": "blue"
    },
    {
     "id": "arrow_summer",
     "op": "line",
     "x1": 400,
     "y1": 600,
     "x2": 500,
     "y2": 600,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "id": "arrow_winter",
     "op": "line",
     "x1": 400,
     "y1": 660,
     "x2": 500,
     "y2": 660,
     "color": "blue",
     "width": 4,
     "arrow": true
    }
   ]
  },
  {
   "title": "More hours of daylight",
   "say": "The tilt also means longer days in summer and shorter days in winter, adding to the effect.",
   "ops": [
    {
     "id": "day_label",
     "op": "write",
     "x": 800,
     "y": 500,
     "text": "Longer days in summer",
     "size": 36,
     "color": "green"
    },
    {
     "id": "night_label",
     "op": "write",
     "x": 800,
     "y": 560,
     "text": "Shorter days in winter",
     "size": 36,
     "color": "gray"
    },
    {
     "id": "sun_path",
     "op": "path",
     "d": "M 950 500 Q 1050 450 1150 500",
     "color": "green",
     "width": 4,
     "arrow": true
    },
    {
     "id": "sun_path2",
     "op": "path",
     "d": "M 950 560 Q 1050 540 1150 560",
     "color": "gray",
     "width": 4,
     "arrow": true
    }
   ]
  },
  {
   "title": "Summary",
   "say": "Seasons are caused by Earth's tilt, not distance from the Sun. The tilt changes the angle and duration of sunlight.",
   "ops": [
    {
     "id": "summary",
     "op": "write",
     "x": 800,
     "y": 700,
     "text": "Seasons are caused by Earth's tilt, not distance.",
     "size": 40,
     "anchor": "middle",
     "color": "blue"
    }
   ]
  }
 ]
