{
 "title": "Why the Pythagorean Theorem Works",
 "lang": "en",
 "steps": [
  {
   "title": "A Right-Angled Triangle",
   "say": "Let's take any right-angled triangle with side lengths a and b, and hypotenuse c.",
   "ops": [
    {
     "op": "write",
     "id": "title",
     "x": 60,
     "y": 40,
     "text": "Visual Proof: a² + b² = c²",
     "size": 52
    },
    {
     "op": "path",
     "id": "tri_demo",
     "d": "M 150 350 L 350 350 L 150 200 Z",
     "color": "blue",
     "width": 4,
     "fill": "blue"
    },
    {
     "op": "rect",
     "id": "tri_corner",
     "x": 150,
     "y": 330,
     "w": 20,
     "h": 20,
     "color": "blue",
     "width": 2
    },
    {
     "op": "write",
     "id": "lbl_a",
     "x": 115,
     "y": 260,
     "text": "a",
     "size": 36,
     "color": "blue"
    },
    {
     "op": "write",
     "id": "lbl_b",
     "x": 240,
     "y": 365,
     "text": "b",
     "size": 36,
     "color": "blue"
    },
    {
     "op": "write",
     "id": "lbl_c",
     "x": 260,
     "y": 250,
     "text": "c",
     "size": 36,
     "color": "blue"
    },
    {
     "op": "write",
     "id": "claim",
     "x": 100,
     "y": 440,
     "text": "We want to prove:\na² + b² = c²",
     "size": 40,
     "color": "ink"
    }
   ]
  },
  {
   "title": "Two Identical Large Squares",
   "say": "We can build two large, identical squares, each with sides of total length a plus b.",
   "ops": [
    {
     "op": "erase",
     "ids": [
      "tri_demo",
      "tri_corner",
      "lbl_a",
      "lbl_b",
      "lbl_c",
      "claim"
     ]
    },
    {
     "op": "write",
     "id": "sq1_title",
     "x": 150,
     "y": 120,
     "text": "Square 1 (Side: a + b)",
     "size": 36,
     "color": "ink"
    },
    {
     "op": "rect",
     "id": "box1",
     "x": 150,
     "y": 180,
     "w": 400,
     "h": 400,
     "color": "ink",
     "width": 4
    },
    {
     "op": "write",
     "id": "sq2_title",
     "x": 900,
     "y": 120,
     "text": "Square 2 (Side: a + b)",
     "size": 36,
     "color": "ink"
    },
    {
     "op": "rect",
     "id": "box2",
     "x": 900,
     "y": 180,
     "w": 400,
     "h": 400,
     "color": "ink",
     "width": 4
    },
    {
     "op": "write",
     "id": "eq_note",
     "x": 680,
     "y": 350,
     "text": "=",
     "size": 60,
     "color": "ink",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Arrangement 1: Four Triangles Around a Center",
   "say": "In the first square, arrange four copies of our triangle around the edges, leaving a tilted square in the middle.",
   "ops": [
    {
     "op": "path",
     "id": "t1_1",
     "d": "M 150 180 L 430 180 L 150 300 Z",
     "color": "blue",
     "fill": "blue",
     "width": 2
    },
    {
     "op": "path",
     "id": "t1_2",
     "d": "M 430 180 L 550 180 L 550 460 Z",
     "color": "blue",
     "fill": "blue",
     "width": 2
    },
    {
     "op": "path",
     "id": "t1_3",
     "d": "M 550 460 L 550 580 L 270 580 Z",
     "color": "blue",
     "fill": "blue",
     "width": 2
    },
    {
     "op": "path",
     "id": "t1_4",
     "d": "M 270 580 L 150 580 L 150 300 Z",
     "color": "blue",
     "fill": "blue",
     "width": 2
    },
    {
     "op": "path",
     "id": "inner_sq",
     "d": "M 430 180 L 550 460 L 270 580 L 150 300 Z",
     "color": "red",
     "width": 4,
     "fill": "red"
    },
    {
     "op": "write",
     "id": "c_sq_lbl",
     "x": 350,
     "y": 360,
     "text": "c²",
     "size": 48,
     "color": "red",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Arrangement 2: Triangles in Pairs",
   "say": "In the second square, pair the four triangles into two rectangles placed in the corners.",
