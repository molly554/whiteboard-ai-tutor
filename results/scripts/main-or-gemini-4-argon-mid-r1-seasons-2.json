{
 "title": "Why Do We Have Seasons?",
 "lang": "en",
 "steps": [
  {
   "title": "Common Myth",
   "say": "Why do we have seasons? Many people think it's about our distance from the Sun, but that's a myth.",
   "ops": [
    {
     "op": "write",
     "id": "main_title",
     "x": 800,
     "y": 50,
     "text": "Why Do We Have Seasons?",
     "size": 56,
     "anchor": "middle",
     "underline": true
    },
    {
     "op": "write",
     "id": "myth_text",
     "x": 800,
     "y": 150,
     "text": "Myth: Closer to the Sun = Summer",
     "size": 40,
     "color": "gray",
     "anchor": "middle"
    },
    {
     "op": "line",
     "id": "myth_strike",
     "x1": 450,
     "y1": 175,
     "x2": 1150,
     "y2": 175,
     "color": "red",
     "width": 5
    },
    {
     "op": "write",
     "id": "real_reason",
     "x": 800,
     "y": 230,
     "text": "Real Reason: Earth's 23.5° Axial Tilt!",
     "size": 44,
     "color": "blue",
     "anchor": "middle"
    }
   ]
  },
  {
