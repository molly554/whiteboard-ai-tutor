    },
    {
     "op": "write",
     "id": "s2_lb",
     "x": 1250,
     "y": 195,
     "text": "b",
     "size": 32,
     "color": "red",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "s2_la2",
     "x": 975,
     "y": 300,
     "text": "a",
     "size": 32,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "s2_lb2",
     "x": 975,
     "y": 475,
     "text": "b",
     "size": 32,
     "color": "red",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "5. Two Smaller Empty Squares",
   "say": "Now the empty space is split into two squares: one is a by a (area a²), and the other is b by b (area b²).",
   "ops": [
    {
     "op": "rect",
     "id": "s2_a2",
     "x": 1000,
     "y": 240,
     "w": 150,
     "h": 150,
     "color": "blue",
     "width": 5,
     "fill": "gray"
    },
    {
     "op": "rect",
     "id": "s2_b2",
     "x": 1150,
     "y": 390,
     "w": 200,
     "h": 200,
     "color": "red",
     "width": 5,
     "fill": "red"
    },
    {
     "op": "write",
     "id": "s2_area_a",
     "x": 1075,
     "y": 295,
     "text": "a²",
     "size": 44,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "s2_area_b",
     "x": 1250,
     "y": 470,
     "text": "b²",
     "size": 48,
     "color": "red",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "s2_cap",
     "x": 1175,
     "y": 620,
     "text": "Empty area = a² + b²",
     "size": 36,
     "color": "ink",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "6. Equal Empty Areas",
   "say": "Since both big squares are the exact same size and both hold the exact same four triangles, their leftover empty spaces must be equal!",
   "ops": [
    {
     "op": "line",
     "id": "conn_arrow",
     "x1": 830,
     "y1": 415,
     "x2": 940,
     "y2": 415,
     "color": "ink",
     "width": 5,
     "arrow": "both"
    },
    {
     "op": "write",
     "id": "logic_txt",
     "x": 885,
     "y": 695,
     "text": "Same big square (a+b)²  −  Same 4 triangles  =  Same leftover area!",
     "size": 36,
     "color": "ink",
     "anchor": "middle"
    },
    {
     "op": "rect",
     "id": "final_box",
     "x": 660,
     "y": 760,
     "w": 450,
     "h": 90,
     "color": "green",
     "width": 5,
     "fill": "green"
    },
    {
     "op": "write",
     "id": "final_eq",
     "x": 885,
     "y": 778,
     "text": "a² + b² = c²",
     "size": 54,
     "color": "ink",
     "anchor": "middle"
    }
   ]
  }
 ]
}