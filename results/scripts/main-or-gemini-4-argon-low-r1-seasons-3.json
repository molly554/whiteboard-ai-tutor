{
 "title": "Why Do We Have Seasons?",
 "lang": "en",
 "steps": [
  {
   "title": "Common Misconception",
   "say": "Many people think we have seasons because Earth gets closer to the Sun in summer, but that's actually not true!",
   "ops": [
    {
     "op": "write",
     "id": "main_title",
     "x": 800,
     "y": 50,
     "text": "Why Do We Have Seasons?",
     "size": 56,
     "anchor": "middle",
     "underline": true
    },
    {
     "op": "write",
     "id": "myth_text",
     "x": 800,
     "y": 140,
     "text": "Myth: Closer to the Sun = Summer",
     "size": 38,
     "color": "red",
     "anchor": "middle"
    },
    {
     "op": "line",
     "id": "myth_strike",
     "x1": 460,
     "y1": 162,
     "x2": 1140,
     "y2": 162,
     "color": "red",
     "width": 4
    }
   ]
  },
  {
   "title": "The Real Reason: Axial Tilt",
   "say": "The real reason is that Earth's spinning axis is tilted by 23.5 degrees relative to its orbit around the Sun.",
   "ops": [
    {
     "op": "erase",
     "ids": [
      "myth_text",
      "myth_strike"
     ]
    },
    {
     "op": "write",
     "id": "truth_text",
     "x": 800,
     "y": 135,
     "text": "Real Reason: Earth's 23.5° Axial Tilt",
     "size": 40,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "ellipse",
     "id": "sun",
     "cx": 420,
     "cy": 460,
     "rx": 65,
     "ry": 65,
     "color": "red",
     "fill": "red"
    },
    {
     "op": "write",
     "id": "sun_lbl",
     "x": 420,
     "y": 545,
     "text": "Sun",
     "size": 34,
     "color": "red",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Earth's Tilted Axis",
   "say": "Instead of standing straight up and down, Earth leans to the side as it spins.",
