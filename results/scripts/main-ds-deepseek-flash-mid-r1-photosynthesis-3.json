    {
     "op": "ellipse",
     "id": "chloroplast",
     "cx": 430,
     "cy": 430,
     "rx": 170,
     "ry": 100,
     "rotate": -15,
     "color": "green",
     "width": 6,
     "fill": "green"
    },
    {
     "op": "write",
     "id": "chloroplast-label",
     "x": 620,
     "y": 390,
     "text": "叶绿体",
     "size": 36,
     "color": "green"
    },
    {
     "op": "line",
     "id": "chloroplast-pointer",
     "x1": 595,
     "y1": 430,
     "x2": 620,
     "y2": 408,
     "color": "gray",
     "width": 3,
     "arrow": true
    }
   ]
  },
  {
