     "id": "r2",
     "x1": 300,
     "y1": 600,
     "x2": 640,
     "y2": 600,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "line",
     "id": "r3",
     "x1": 300,
     "y1": 700,
     "x2": 640,
     "y2": 700,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "ellipse",
