    {
     "op": "line",
     "id": "d2",
     "x1": 400,
     "y1": 240,
     "x2": 1180,
     "y2": 660,
     "color": "green",
     "width": 5
    },
    {
     "op": "write",
     "id": "label_d2",
     "x": 1190,
     "y": 650,
     "text": "D2",
     "size": 32,
     "color": "green"
    },
    {
     "op": "write",
     "id": "shift_arrow",
     "x": 700,
     "y": 350,
     "text": "→",
     "size": 40,
     "anchor": "middle",
     "color": "ink"
    },
    {
     "op": "write",
     "id": "note_shift",
     "x": 760,
     "y": 350,
     "text": "demand rises",
     "size": 28,
     "color": "ink"
    }
   ]
  },
  {
   "title": "New equilibrium",
   "say": "The new intersection with supply is at a higher price and higher quantity.",
