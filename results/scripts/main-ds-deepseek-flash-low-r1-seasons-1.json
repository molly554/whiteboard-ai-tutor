    {
     "id": "tilt_label",
     "op": "write",
     "x": 80,
     "y": 300,
     "text": "Earth's axis is tilted ~23.5°",
     "size": 40,
     "color": "blue"
    },
    {
     "id": "earth_circle",
     "op": "ellipse",
     "cx": 400,
     "cy": 500,
     "rx": 100,
     "ry": 100,
     "color": "blue",
     "width": 4
    },
    {
     "id": "axis_line",
     "op": "line",
     "x1": 400,
     "y1": 350,
     "x2": 400,
     "y2": 650,
     "color": "gray",
     "width": 3,
     "dash": true
    },
    {
     "id": "tilt_axis",
     "op": "line",
     "x1": 370,
     "y1": 380,
     "x2": 430,
     "y2": 620,
     "color": "red",
     "width": 5
    },
    {
     "id": "tilt_angle",
     "op": "path",
     "d": "M 400 500 L 430 500 A 30 30 0 0 1 420 480",
     "color": "red",
     "width": 2
    },
