{
 "title": "Why a² + b² = c²",
 "lang": "en",
 "steps": [
  {
   "title": "The claim",
   "say": "In a right triangle with legs a and b and hypotenuse c, the squares on the legs together have the same area as the square on the hypotenuse.",
   "ops": [
    {
     "op": "write",
     "id": "title",
     "x": 60,
     "y": 40,
     "text": "Why a² + b² = c²",
     "size": 54
    },
    {
     "op": "path",
     "id": "tri",
     "d": "M 200 600 L 200 300 L 600 600 Z",
     "color": "ink",
     "width": 5
    },
    {
     "op": "write",
     "id": "la",
     "x": 110,
     "y": 430,
     "text": "a",
     "size": 36
    },
    {
     "op": "write",
     "id": "lb",
     "x": 380,
     "y": 620,
     "text": "b",
     "size": 36
    },
    {
     "op": "write",
     "id": "lc",
     "x": 430,
     "y": 400,
     "text": "c",
     "size": 36
    },
    {
     "op": "write",
     "id": "claim",
     "x": 900,
     "y": 400,
     "text": "a² + b² = c²",
     "size": 60,
     "color": "blue"
    }
   ]
  },
  {
   "title": "Big square",
   "say": "Take four copies of the triangle and arrange them inside a big square whose side is a + b. The big square's area is (a + b)².",
   "ops": [
    {
     "op": "erase",
     "all": true
    },
    {
     "op": "write",
     "id": "t2",
     "x": 60,
     "y": 40,
     "text": "Square of side a + b",
     "size": 54
    },
    {
     "op": "rect",
     "id": "big",
     "x": 500,
     "y": 200,
     "w": 560,
     "h": 560,
     "color": "ink",
     "width": 5
    },
    {
     "op": "write",
     "id": "area1",
     "x": 1120,
     "y": 440,
     "text": "area = (a + b)²",
     "size": 40,
     "color": "blue"
    }
   ]
  },
  {
   "title": "Tilted square",
   "say": "Place the four triangles in the corners so their hypotenuses form a tilted square in the middle. Its side is c.",
   "ops": [
    {
     "op": "line",
     "id": "s1",
     "x1": 500,
     "y1": 480,
     "x2": 780,
     "y2": 200,
     "color": "green",
     "width": 5
    },
    {
     "op": "line",
     "id": "s2",
     "x1": 780,
     "y1": 200,
     "x2": 1060,
     "y2": 480,
     "color": "green",
     "width": 5
    },
    {
     "op": "line",
     "id": "s3",
     "x1": 1060,
     "y1": 480,
     "x2": 780,
     "y2": 760,
     "color": "green",
     "width": 5
    },
    {
     "op": "line",
     "id": "s4",
     "x1": 780,
     "y1": 760,
     "x2": 500,
     "y2": 480,
     "color": "green",
     "width": 5
    },
    {
     "op": "write",
     "id": "cc",
     "x": 780,
     "y": 440,
     "text": "c²",
     "size": 54,
     "anchor": "middle",
     "color": "green"
    }
   ]
  },
  {
   "title": "Count the area",
   "say": "The big square equals four triangles plus the tilted square. Each triangle has area ab/2, so the total is 4·(ab/2) + c² = 2ab + c².",
   "ops": [
    {
     "op": "erase",
     "all": true
    },
    {
     "op": "write",
     "id": "t3",
     "x": 60,
     "y": 40,
     "text": "Add up the pieces",
     "size": 54
    },
    {
     "op": "write",
     "id": "e1",
     "x": 200,
     "y": 260,
     "text": "big square = 4 triangles + tilted square",
     "size": 40
    },
    {
     "op": "write",
     "id": "e2",
     "x": 200,
     "y": 400,
     "text": "(a + b)² = 4 · (ab/2) + c²",
     "size": 48,
     "color": "blue"
    },
    {
     "op": "write",
     "id": "e3",
     "x": 200,
     "y": 540,
     "text": "(a + b)² = 2ab + c²",
     "size": 48,
     "color": "blue"
    }
   ]
  },
  {
   "title": "Expand",
   "say": "Now expand the left side: (a + b)² is a² + 2ab + b². So a² + 2ab + b² = 2ab + c².",
   "ops": [
    {
     "op": "write",
     "id": "e4",
     "x": 200,
     "y": 680,
     "text": "a² + 2ab + b² = 2ab + c²",
     "size": 48,
     "color": "ink"
    }
   ]
  },
  {
   "title": "Cancel",
   "say": "Subtract 2ab from both sides, and what remains is the theorem: a² + b² = c². It works because the same big square can be cut into pieces in two ways.",
   "ops": [
    {
     "op": "erase",
     "all": true
    },
    {
     "op": "write",
     "id": "t5",
     "x": 60,
     "y": 40,
     "text": "The result",
     "size": 54
    },
    {
     "op": "write",
     "id": "f1",
     "x": 200,
     "y": 300,
     "text": "a² + 2ab + b² = 2ab + c²",
     "size": 48
    },
    {
     "op": "write",
     "id": "f2",
     "x": 200,
     "y": 420,
     "text": "subtract 2ab from both sides",
     "size": 40,
     "color": "gray"
    },
    {
     "op": "write",
     "id": "f3",
     "x": 200,
     "y": 540,
     "text": "a² + b² = c²",
     "size": 72,
     "color": "green",
     "underline": true
    }
   ]
  }
 ]
}