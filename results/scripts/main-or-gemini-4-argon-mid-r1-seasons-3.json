  },
  {
   "title": "June: Northern Summer",
   "say": "In June, the Northern Hemisphere tilts toward the Sun, giving the North summer while the South has winter.",
   "ops": [
    {
     "op": "line",
     "id": "ray_l1",
     "x1": 710,
     "y1": 435,
     "x2": 380,
     "y2": 435,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "line",
     "id": "ray_l2",
     "x1": 710,
     "y1": 485,
     "x2": 380,
     "y2": 485,
     "color": "red",
     "width": 4,
     "arrow": true
    },
    {
     "op": "write",
     "id": "june_title",
     "x": 320,
     "y": 560,
     "text": "June",
     "size": 40,
     "color": "blue",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "june_n",
