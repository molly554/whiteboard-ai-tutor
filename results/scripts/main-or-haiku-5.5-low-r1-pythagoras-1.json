{
 "title": "Why a² + b² = c²",
 "lang": "en",
 "steps": [
  {
   "title": "Title",
   "say": "We will show why the Pythagorean theorem holds, using areas.",
   "ops": [
    {
     "op": "write",
     "id": "t",
     "x": 800,
     "y": 60,
     "text": "Why a² + b² = c²?",
     "size": 56,
     "anchor": "middle",
     "underline": true
    }
   ]
  },
  {
   "title": "Big square",
   "say": "Start with a square whose side is a + b, so its area is (a+b)².",
   "ops": [
    {
     "op": "rect",
     "id": "sq",
     "x": 200,
     "y": 200,
     "w": 420,
     "h": 420,
     "color": "ink",
     "width": 5
    }
   ]
  },
  {
   "title": "Four right triangles",
   "say": "Place four copies of the same right triangle, with legs a and b, in the corners. Each triangle has area ½ab.",
   "ops": [
    {
     "op": "path",
     "id": "T1",
     "d": "M200 200 L380 200 L200 440 Z",
     "color": "blue",
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "T2",
     "d": "M620 200 L620 380 L380 200 Z",
     "color": "blue",
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "T3",
     "d": "M620 620 L440 620 L620 380 Z",
     "color": "blue",
     "fill": "blue"
    },
    {
     "op": "path",
     "id": "T4",
     "d": "M200 620 L200 440 L440 620 Z",
     "color": "blue",
     "fill": "blue"
    },
    {
     "op": "write",
     "id": "la1",
     "x": 290,
     "y": 150,
     "text": "a",
     "size": 34,
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "lb1",
     "x": 500,
     "y": 150,
     "text": "b",
     "size": 34,
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "la2",
     "x": 650,
     "y": 290,
     "text": "a",
     "size": 34
    },
    {
     "op": "write",
     "id": "lb2",
     "x": 650,
     "y": 500,
     "text": "b",
     "size": 34
    },
    {
     "op": "write",
     "id": "lb3",
     "x": 320,
     "y": 650,
     "text": "b",
     "size": 34,
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "la3",
     "x": 530,
     "y": 650,
     "text": "a",
     "size": 34,
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "lb4",
     "x": 150,
     "y": 320,
     "text": "b",
     "size": 34
    },
    {
     "op": "write",
     "id": "la4",
     "x": 150,
     "y": 530,
     "text": "a",
     "size": 34
    }
   ]
  },
  {
   "title": "Inner square",
   "say": "The hypotenuses of the four triangles form a tilted square with side c. Its area is c².",
   "ops": [
    {
     "op": "path",
     "id": "inner",
     "d": "M380 200 L620 380 L440 620 L200 440 Z",
     "color": "red",
     "width": 6
    },
    {
     "op": "write",
     "id": "c",
     "x": 410,
     "y": 390,
     "text": "c",
     "size": 48,
     "color": "red",
     "anchor": "middle"
    }
   ]
  },
  {
   "title": "Count the area",
   "say": "The big square is made of four triangles plus the inner square. Its area is also (a+b)².",
   "ops": [
    {
     "op": "write",
     "id": "A1",
     "x": 700,
     "y": 200,
     "text": "Big square = (a+b)²",
     "size": 36
    },
    {
     "op": "write",
     "id": "A2",
     "x": 700,
     "y": 260,
     "text": "= 4 triangles + inner square",
     "size": 36
    },
    {
     "op": "write",
     "id": "A3",
     "x": 700,
     "y": 330,
     "text": "Each triangle = ½ab",
     "size": 36
    },
    {
     "op": "write",
     "id": "A4",
     "x": 700,
     "y": 390,
     "text": "4 triangles = 2ab",
     "size": 36
    }
   ]
  },
  {
   "title": "Solve",
   "say": "Set the two expressions equal. The 2ab terms cancel, leaving c² = a² + b².",
   "ops": [
    {
     "op": "write",
     "id": "E1",
     "x": 700,
     "y": 480,
     "text": "a² + 2ab + b² = 2ab + c²",
     "size": 36
    },
    {
     "op": "write",
     "id": "E2",
     "x": 700,
     "y": 560,
     "text": "⇒  c² = a² + b²",
     "size": 52,
     "color": "red"
    }
   ]
  }
 ]
}