  {
   "title": "Summary",
   "say": "To sum up: Earth's constant tilt plus its orbit changes the angle of sunlight, creating our seasons.",
   "ops": [
    {
     "op": "rect",
     "id": "summary_box",
     "x": 380,
     "y": 815,
     "w": 840,
