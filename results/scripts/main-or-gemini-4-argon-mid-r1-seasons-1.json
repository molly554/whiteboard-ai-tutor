  {
   "title": "Why Tilt Changes Temperature",
   "say": "When tilted toward the Sun, sunlight hits directly and concentrates heat. When tilted away, light spreads out and is weaker.",
   "ops": [
    {
     "op": "rect",
     "id": "box_dir",
     "x": 120,
     "y": 750,
     "w": 620,
     "h": 110,
     "color": "red",
     "fill": "red"
    },
    {
     "op": "write",
     "id": "txt_dir1",
     "x": 430,
     "y": 765,
     "text": "Tilted Toward Sun (Summer)",
     "size": 32,
     "color": "red",
     "anchor": "middle"
    },
    {
     "op": "write",
     "id": "txt_dir2",
     "x": 430,
     "y": 810,
     "text": "Direct rays + Longer days = Warmer",
     "size": 28,
     "color": "ink",
     "anchor": "middle"
    },
    {
     "op": "rect",
     "id": "box_ang",
     "x": 860,
