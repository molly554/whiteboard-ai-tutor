  {
   "title": "Day length effect",
   "say": "Tilting toward the Sun also means staying in daylight for over 15 hours, giving the land more time to warm up.",
   "ops": [
    {
     "op": "write",
     "id": "factor2_title",
     "x": 980,
     "y": 125,
     "text": "2. Daylight Hours",
     "size": 38,
     "color": "blue"
    },
    {
     "op": "write",
     "id": "factor2_desc",
     "x": 980,
     "y": 180,
     "text": "Summer: 15+ hours of sun\n  → Long heating time\n\nWinter: only 8-9 hours\n  → Short heating time",
     "size": 28
    }
   ]
  },
  {
   "title": "Distance change is tiny",
   "say": "Earth's orbit is nearly a circle. Distance varies by only 3 percent, completely dwarfed by the tilt effect.",
